---
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "ghost";
  size?: "sm" | "md";
  external?: boolean;
  class?: string;
}

const { href, variant = "primary", size = "md", external = false, class: className = "" } =
  Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 rounded-full font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring";

const sizes: Record<NonNullable<Props["size"]>, string> = {
  sm: "px-3.5 py-1.5 text-sm",
  md: "px-5 py-2.5 text-sm sm:text-base",
};

const variants: Record<NonNullable<Props["variant"]>, string> = {
  primary: "bg-accent text-accent-fg hover:bg-accent-hover",
  secondary: "border border-border bg-surface text-fg hover:border-accent hover:text-accent",
  ghost: "text-fg hover:bg-surface",
};

const rel = external ? "noopener noreferrer" : undefined;
const target = external ? "_blank" : undefined;
---

<a
  href={href}
  class:list={[base, sizes[size], variants[variant], className]}
  rel={rel}
  target={target}
>
  <slot />
</a>
