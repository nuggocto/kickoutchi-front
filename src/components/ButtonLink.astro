---
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "ghost";
  size?: "sm" | "md";
  external?: boolean;
  class?: string;
}

const { href, variant = "primary", size = "md", external = false, class: className = "" } =
  Astro.props;

// Chunky moulded-plastic buttons: hard outline + offset shadow, pressed flat
// on :active like a real device button.
const base =
  "btn-chunk inline-flex items-center justify-center gap-2 rounded-lg font-semibold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring";

const sizes: Record<NonNullable<Props["size"]>, string> = {
  sm: "px-3.5 py-1.5 text-sm",
  md: "px-5 py-2.5 text-sm sm:text-base",
};

const variants: Record<NonNullable<Props["variant"]>, string> = {
  primary: "border-2 border-border-strong bg-accent text-accent-fg",
  secondary: "border-2 border-border-strong bg-surface text-fg hover:text-accent",
  ghost: "text-fg hover:bg-surface border-2 border-transparent",
};

const rel = external ? "noopener noreferrer" : undefined;
const target = external ? "_blank" : undefined;
---

<a
  href={href}
  class:list={[base, sizes[size], variants[variant], variant !== "ghost" && "btn-shadow", className]}
  rel={rel}
  target={target}
>
  <slot />
</a>

<style>
  .btn-chunk {
    transition:
      transform 120ms ease,
      box-shadow 120ms ease,
      color 120ms ease,
      background-color 120ms ease;
  }
  .btn-shadow {
    box-shadow: 4px 4px 0 0 var(--chunk-shadow);
  }
  .btn-shadow:hover {
    transform: translate(-1px, -1px);
    box-shadow: 5px 5px 0 0 var(--chunk-shadow);
  }
  .btn-shadow:active {
    transform: translate(3px, 3px);
    box-shadow: 1px 1px 0 0 var(--chunk-shadow);
  }
</style>
