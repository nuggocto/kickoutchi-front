---
/**
 * The landing-page demo: a swamp motel where every port is a room.
 *
 * Pick a door, inspect who's squatting in it, review the kick, confirm. The
 * neon sign lights "VACANCY" as soon as one port is free. The demo mirrors the
 * real flow (read-only inspect, one owner by default, --tree only on request,
 * nothing stops before confirmation). Without JS it stays a static preview.
 */

/** Turn an ASCII pixel map into SVG rect coordinates. */
const px = (map: string[]) =>
  map.flatMap((row, y) => [...row].flatMap((cell, x) => (cell === "1" ? [{ x, y }] : [])));

// The port squatter: round blob, stubby ears, hollow eyes, tiny feet.
const CRITTER = px([
  "..1..1..",
  "..1111..",
  ".111111.",
  "11.11.11",
  "11111111",
  "11111111",
  ".111111.",
  ".1.11.1.",
]);

// The stubborn boot, toe pointing right at the door.
const BOOT = px([
  ".111......",
  ".111......",
  ".1111.....",
  ".11111....",
  ".111111...",
  ".11111111.",
  "1111111111",
  "1111111111",
]);

const ROOMS = [
  { port: "3000", proc: "node", pid: "18422", tree: ["node     18422", "├ vite   18431", "└ esbuild 18444"] },
  { port: "5173", proc: "vite", pid: "21077", tree: ["vite     21077", "└ esbuild 21093"] },
  { port: "8080", proc: "python", pid: "9021", tree: ["python   9021"] },
];
const first = ROOMS[0];
---

<div class="vacancy" data-vacancy={JSON.stringify(ROOMS)} data-state="found" data-selected="0" data-lit="no">
  <p class="sr-only" role="status" aria-live="polite" data-status>
    Demo: node is squatting on port 3000. Inspect it or kick it out.
  </p>

  <div class="sign-post" aria-hidden="true">
    <p class="sign font-pixel text-display"><span class="sign-no">No</span> Vacancy</p>
  </div>

  <div class="facade">
    <ul class="doors" aria-label="Demo ports">
      {ROOMS.map((room, i) => (
        <li>
          <button
            type="button"
            class="door"
            data-door={i}
            data-status="occupied"
            aria-pressed={i === 0 ? "true" : "false"}
            aria-label={`Port ${room.port}, occupied by ${room.proc}`}
          >
            <span class="room" aria-hidden="true">
              <span class="room-tag font-mono text-sm">Vacant</span>
            </span>
            <span class="leaf" aria-hidden="true">
              <span class="plate font-pixel text-lg">{room.port}</span>
              <span class="window"></span>
              <span class="knob"></span>
              <span class="hanger font-mono text-sm">{room.proc}</span>
            </span>
            <svg class="critter" viewBox="0 0 8 8" shape-rendering="crispEdges" aria-hidden="true">
              {CRITTER.map((p) => <rect x={p.x} y={p.y} width="1" height="1" fill="currentColor" />)}
            </svg>
            <svg class="boot" viewBox="0 0 10 8" shape-rendering="crispEdges" aria-hidden="true">
              {BOOT.map((p) => <rect x={p.x} y={p.y} width="1" height="1" fill="currentColor" />)}
            </svg>
          </button>
        </li>
      ))}
    </ul>

    <section class="desk" aria-label="Front desk">
      <h3 class="text-lg font-bold">Port <span data-b="port">{first.port}</span></h3>

      <div class="desk-step" data-step="found">
        <p class="text-lg leading-snug">
          <span class="font-mono" data-b="proc">{first.proc}</span> is squatting here.
        </p>
        <p class="mt-1 text-sm text-muted">
          PID <span data-b="pid">{first.pid}</span>, <span data-b="count">3 processes</span> in its tree.
        </p>
        <div class="desk-actions">
          <button type="button" class="desk-btn" data-act="inspect">Inspect</button>
          <button type="button" class="desk-btn desk-btn-kick" data-act="review">Kick out</button>
        </div>
      </div>

      <div class="desk-step" data-step="inspect">
        <pre class="tree font-mono text-sm" data-b="tree">{first.tree.join("\n")}</pre>
        <p class="mt-2 text-sm text-muted">Read-only. Nothing was stopped.</p>
        <div class="desk-actions">
          <button type="button" class="desk-btn desk-btn-kick" data-act="review">Kick out</button>
          <button type="button" class="desk-btn" data-act="back">Back</button>
        </div>
      </div>

      <div class="desk-step" data-step="confirm">
        <p class="text-lg leading-snug">
          Kick <span class="font-mono" data-b="proc">{first.proc}</span> off port <span data-b="port">{first.port}</span>?
        </p>
        <label class="tree-toggle mt-2 text-sm" data-tree-toggle>
          <input type="checkbox" data-b="use-tree" />
          Also stop its <span data-b="children">2</span> child processes
        </label>
        <code class="cmd font-mono text-sm" data-b="cmd">kick kill --port {first.port}</code>
        <div class="desk-actions">
          <button type="button" class="desk-btn desk-btn-kick" data-act="confirm">Confirm kick</button>
          <button type="button" class="desk-btn" data-act="back">Cancel</button>
        </div>
      </div>

      <div class="desk-step" data-step="kicking">
        <p class="text-lg leading-snug">Kicking…</p>
      </div>

      <div class="desk-step" data-step="free">
        <p class="text-lg leading-snug">This port is free.</p>
        <p class="mt-1 text-sm text-muted" data-b="result">Stopped node, PID 18422.</p>
        <div class="desk-actions">
          <button type="button" class="desk-btn" data-act="next">Next squatter</button>
        </div>
      </div>

      <p class="desk-note text-sm text-muted">This is a demo. Pick a door to start.</p>
    </section>
  </div>

  <div class="boardwalk" aria-hidden="true"></div>
  <noscript><p class="mt-3 text-sm text-muted">Enable JavaScript to play the demo.</p></noscript>
</div>

<style>
  .vacancy {
    --wall: var(--accent);
    --neon: var(--kick);
    --night: var(--border-strong);
  }

  /* ---- Neon sign ---- */
  .sign-post {
    display: flex;
    justify-content: center;
    position: relative;
    padding-bottom: 1.25rem;
  }
  /* Two chains holding the sign above the roofline. */
  .sign-post::before,
  .sign-post::after {
    content: "";
    position: absolute;
    bottom: 0;
    width: 0;
    height: 1.25rem;
    border-left: 3px dotted var(--night);
  }
  .sign-post::before {
    left: 30%;
  }
  .sign-post::after {
    right: 30%;
  }
  .sign {
    margin: 0;
    padding: 0.2em 0.45em 0.28em;
    background: var(--night);
    border-radius: 0.2em;
    color: var(--neon);
    white-space: nowrap;
    text-shadow:
      0 0 0.08em var(--neon),
      0 0 0.35em rgb(240 85 44 / 0.55);
    box-shadow: 6px 6px 0 0 rgb(26 35 27 / 0.25);
  }
  .sign-no {
    transition:
      color 120ms,
      text-shadow 120ms,
      opacity 120ms;
  }
  .vacancy[data-lit="yes"] .sign-no {
    color: #4a3a33;
    text-shadow: none;
  }
  .vacancy[data-flicker] .sign {
    animation: neon-flicker 700ms steps(1) 1;
  }
  @keyframes neon-flicker {
    0%,
    30%,
    60% {
      opacity: 1;
    }
    15%,
    45% {
      opacity: 0.35;
    }
  }

  /* ---- The motel wall ---- */
  .facade {
    display: grid;
    gap: 1.25rem;
    padding: 1.25rem;
    background:
      repeating-linear-gradient(0deg, rgb(0 0 0 / 0.07) 0 2px, transparent 2px 28px),
      var(--wall);
    border: 3px solid var(--night);
    border-bottom: 0;
    border-radius: 0.75rem 0.75rem 0 0;
  }
  @media (min-width: 900px) {
    .facade {
      grid-template-columns: 1.35fr 1fr;
      align-items: end;
      gap: 2rem;
      padding: 2rem 2rem 0;
    }
  }

  .doors {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.6rem, 2.5vw, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
    align-self: end;
  }

  /* ---- A door: room behind, leaf in front ---- */
  .door {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 3 / 5;
    padding: 0;
    border: 3px solid var(--night);
    border-bottom: 0;
    border-radius: 0.4rem 0.4rem 0 0;
    background: var(--night);
    perspective: 700px;
    cursor: pointer;
    color: var(--fg);
  }
  .door:focus-visible {
    outline: 3px solid var(--bg);
    outline-offset: 3px;
  }
  .door[aria-pressed="true"] {
    box-shadow:
      0 0 0 3px var(--neon),
      0 0 18px 2px rgb(240 85 44 / 0.45);
  }

  .room {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: 0 8% 12% 0;
    background: linear-gradient(180deg, #2b3a2c, var(--night) 70%);
  }
  .room-tag {
    color: var(--bg);
    opacity: 0;
  }
  .door[data-status="vacant"] .room-tag {
    opacity: 1;
  }

  .leaf {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 12%;
    background:
      linear-gradient(90deg, rgb(255 255 255 / 0.35), transparent 30%),
      var(--surface);
    transform-origin: left center;
    transition: transform 520ms cubic-bezier(0.3, 1.4, 0.5, 1);
    backface-visibility: hidden;
  }
  .door:hover .leaf {
    transform: rotateY(-8deg);
  }
  .door[data-status="kicking"] .leaf,
  .door[data-status="vacant"] .leaf {
    transform: rotateY(-72deg);
  }
  .plate {
    padding: 0.05em 0.45em;
    border: 2px solid var(--night);
    border-radius: 0.25rem;
    background: var(--bg);
    line-height: 1.2;
  }
  /* Door is 3:5, so 52% of its width is 31.2% of its height. The critter
     below is placed against the same numbers to sit inside this window. */
  .window {
    position: absolute;
    top: 30%;
    left: 24%;
    width: 52%;
    aspect-ratio: 1;
    border: 3px solid var(--night);
    border-radius: 50% 50% 0.3rem 0.3rem;
    background: #cfd8b5;
  }
  .knob {
    position: absolute;
    right: 12%;
    top: 62%;
    width: 0.6rem;
    height: 0.6rem;
    border: 2px solid var(--night);
    border-radius: 999px;
    background: var(--neon);
  }
  .hanger {
    position: absolute;
    right: 6%;
    top: 68%;
    max-width: 88%;
    padding: 0.15rem 0.4rem;
    border: 2px solid var(--night);
    border-radius: 0.25rem;
    background: #f5dd8a;
    transform: rotate(-4deg);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* The squatter peers out of the window; on a kick it flies off. */
  .critter {
    position: absolute;
    left: 50%;
    top: 38%;
    width: 34%;
    translate: -50% 0;
    color: var(--night);
    pointer-events: none;
  }
  .door[data-status="kicking"] .critter {
    animation: critter-fly 760ms steps(7) 180ms forwards;
  }
  .door[data-status="vacant"] .critter {
    visibility: hidden;
  }
  @keyframes critter-fly {
    to {
      transform: translate(170%, -150%) rotate(420deg);
      opacity: 0;
    }
  }

  .boot {
    position: absolute;
    left: -18%;
    bottom: 4%;
    width: 46%;
    color: var(--neon);
    filter: drop-shadow(2px 2px 0 var(--night));
    opacity: 0;
    pointer-events: none;
  }
  .door[data-status="kicking"] .boot {
    animation: boot-swing 480ms steps(3) forwards;
  }
  @keyframes boot-swing {
    0% {
      opacity: 1;
      transform: translateX(-60%) rotate(20deg);
    }
    70% {
      opacity: 1;
      transform: translateX(25%) rotate(-12deg);
    }
    100% {
      opacity: 0;
      transform: translateX(25%) rotate(-12deg);
    }
  }

  /* ---- Front desk ---- */
  .desk {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.1rem 1.1rem 1rem;
    background: var(--surface);
    border: 3px solid var(--night);
    border-radius: 0.5rem;
  }
  @media (min-width: 900px) {
    .desk {
      margin-bottom: 2rem;
    }
  }
  .desk-step {
    display: none;
  }
  .vacancy[data-state="found"] [data-step="found"],
  .vacancy[data-state="inspect"] [data-step="inspect"],
  .vacancy[data-state="confirm"] [data-step="confirm"],
  .vacancy[data-state="kicking"] [data-step="kicking"],
  .vacancy[data-state="free"] [data-step="free"] {
    display: block;
  }
  .desk-note {
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 2px dashed var(--border);
  }
  .desk-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1rem;
  }
  .desk-btn {
    min-height: 2.75rem;
    padding: 0.4rem 1rem;
    border: 2px solid var(--night);
    border-radius: 0.4rem;
    background: var(--bg);
    font-size: var(--text-sm);
    font-weight: 600;
    box-shadow: 3px 3px 0 0 var(--night);
    cursor: pointer;
    transition:
      transform 90ms ease,
      box-shadow 90ms ease;
  }
  .desk-btn:active {
    transform: translate(3px, 3px);
    box-shadow: 0 0 0 0 var(--night);
  }
  .desk-btn-kick {
    background: var(--neon);
    color: var(--night);
  }
  .tree {
    margin: 0;
    padding: 0.7rem 0.8rem;
    border-radius: 0.35rem;
    background: var(--night);
    color: #d9e0c4;
    line-height: 1.6;
    overflow-x: auto;
  }
  .tree-toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    cursor: pointer;
  }
  .tree-toggle input {
    width: 1.1rem;
    height: 1.1rem;
    accent-color: var(--accent);
  }
  .vacancy[data-single] .tree-toggle {
    display: none;
  }
  .cmd {
    display: block;
    margin-top: 0.5rem;
    padding: 0.5rem 0.7rem;
    border-radius: 0.35rem;
    background: var(--night);
    color: #d9e0c4;
    overflow-wrap: anywhere;
  }
  .cmd::before {
    content: "$ ";
    color: #b7d073;
  }

  /* ---- Boardwalk the whole motel stands on ---- */
  .boardwalk {
    height: 1.1rem;
    border: 3px solid var(--night);
    border-radius: 0 0 0.4rem 0.4rem;
    background:
      repeating-linear-gradient(90deg, transparent 0 46px, var(--night) 46px 49px),
      #a07a4c;
  }

  @media (prefers-reduced-motion: reduce) {
    .leaf {
      transition: none;
    }
    .door[data-status="kicking"] .critter,
    .door[data-status="kicking"] .boot,
    .vacancy[data-flicker] .sign {
      animation: none;
    }
  }
</style>

<script>
  interface Room {
    port: string;
    proc: string;
    pid: string;
    tree: string[];
  }

  type State = "found" | "inspect" | "confirm" | "kicking" | "free";

  const REDUCED = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function wireBoard(board: HTMLElement) {
    const doors = [...board.querySelectorAll<HTMLButtonElement>("[data-door]")];
    const rooms: Room[] = JSON.parse(board.dataset.vacancy ?? "[]");
    const results: (string | null)[] = rooms.map(() => null);
    const useTree = board.querySelector<HTMLInputElement>('[data-b="use-tree"]')!;
    const status = board.querySelector<HTMLElement>("[data-status]")!;
    let selected = 0;
    let timer = 0;

    const bind = (key: string, value: string) => {
      for (const el of board.querySelectorAll<HTMLElement>(`[data-b="${key}"]`)) el.textContent = value;
    };

    function command(room: Room) {
      return useTree.checked ? `kick kill --pid ${room.pid} --tree` : `kick kill --port ${room.port}`;
    }

    function render(state: State, announce: string) {
      const room = rooms[selected];
      const children = room.tree.length - 1;
      board.dataset.state = state;
      board.dataset.selected = String(selected);
      board.toggleAttribute("data-single", children === 0);
      bind("port", room.port);
      bind("proc", room.proc);
      bind("pid", room.pid);
      bind("count", room.tree.length === 1 ? "1 process" : `${room.tree.length} processes`);
      bind("children", String(children));
      bind("tree", room.tree.join("\n"));
      bind("cmd", command(room));
      bind("result", results[selected] ?? "");
      const anyLeft = results.some((r) => r === null);
      const next = board.querySelector<HTMLElement>('[data-act="next"]');
      if (next) next.textContent = anyLeft ? "Next squatter" : "Let them back in";

      doors.forEach((door, i) => {
        door.setAttribute("aria-pressed", String(i === selected));
        const vacant = results[i] !== null;
        door.setAttribute(
          "aria-label",
          vacant ? `Port ${rooms[i].port}, vacant` : `Port ${rooms[i].port}, occupied by ${rooms[i].proc}`,
        );
      });

      const lit = results.some((r) => r !== null) ? "yes" : "no";
      if (lit !== board.dataset.lit) {
        board.dataset.lit = lit;
        if (!REDUCED) {
          board.removeAttribute("data-flicker");
          void board.offsetWidth;
          board.setAttribute("data-flicker", "");
        }
      }
      status.textContent = announce;
    }

    function focusStep(state: State) {
      board.querySelector<HTMLElement>(`[data-step="${state}"] button, [data-step="${state}"] input`)?.focus();
    }

    function select(i: number) {
      window.clearTimeout(timer);
      if (board.dataset.state === "kicking") return;
      selected = i;
      useTree.checked = false;
      const room = rooms[i];
      if (results[i] !== null) render("free", `Port ${room.port} is vacant.`);
      else render("found", `${room.proc} is squatting on port ${room.port}. Inspect it or kick it out.`);
    }

    function reset() {
      results.fill(null);
      for (const door of doors) door.dataset.status = "occupied";
      select(0);
      focusStep("found");
    }

    function kick() {
      const room = rooms[selected];
      const door = doors[selected];
      const children = room.tree.length - 1;
      results[selected] =
        useTree.checked && children > 0
          ? `Stopped ${room.proc}, PID ${room.pid}, and its ${children} child ${children === 1 ? "process" : "processes"}.`
          : `Stopped ${room.proc}, PID ${room.pid}.`;
      door.dataset.status = "kicking";
      render("kicking", `Stopping ${room.proc}.`);
      timer = window.setTimeout(
        () => {
          door.dataset.status = "vacant";
          render("free", `Port ${room.port} is free. ${results[selected]}`);
          focusStep("free");
        },
        REDUCED ? 120 : 1000,
      );
    }

    board.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      const door = target.closest<HTMLElement>("[data-door]");
      if (door) {
        select(Number(door.dataset.door));
        return;
      }
      const act = target.closest<HTMLElement>("[data-act]")?.dataset.act;
      const room = rooms[selected];
      switch (act) {
        case "inspect":
          render("inspect", `Process tree: ${room.tree.join(", ")}. Nothing was stopped.`);
          focusStep("inspect");
          break;
        case "review":
          render("confirm", `Kick ${room.proc} off port ${room.port}? Confirm or cancel.`);
          focusStep("confirm");
          break;
        case "back":
          select(selected);
          focusStep("found");
          break;
        case "confirm":
          kick();
          break;
        case "next": {
          const nextIndex = results.findIndex((r) => r === null);
          if (nextIndex === -1) reset();
          else {
            select(nextIndex);
            focusStep("found");
          }
          break;
        }
      }
    });

    useTree.addEventListener("change", () => bind("cmd", command(rooms[selected])));
  }

  function wireBoards() {
    for (const board of document.querySelectorAll<HTMLElement>("[data-vacancy]:not([data-wired])")) {
      board.dataset.wired = "true";
      wireBoard(board);
    }
  }

  wireBoards();
  document.addEventListener("astro:page-load", wireBoards);
</script>
