---
import LogoMark from "./LogoMark.astro";
import { MAIN_NAV } from "../data/nav";
import { LINKS, SITE } from "../data/links";

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);
const internalNav = MAIN_NAV.filter((item) => !item.external);
---

<header
  class="site-header sticky top-0 z-50 border-b-2 border-border-strong bg-bg/85 backdrop-blur supports-[backdrop-filter]:bg-bg/75"
  data-hidden="false"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3">
    <a href="/" class="group flex items-center gap-2.5" aria-label={`${SITE.name} home`}>
      <LogoMark alt="" width={36} height={36} class="size-9 shrink-0 object-contain transition-transform group-hover:-rotate-6" />
      <span class="font-pixel text-xl leading-none tracking-wide">Kickoutchi</span>
      <span class="hidden rounded border border-border bg-surface px-1.5 py-0.5 font-mono text-xs text-muted sm:inline">
        v{SITE.version}
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {
        internalNav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "rounded-md px-3.5 py-1.5 text-sm font-medium transition-colors hover:bg-surface",
              isActive(item.href) ? "text-accent" : "text-muted hover:text-fg",
            ]}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            <span class:list={["select-none", isActive(item.href) ? "text-kick" : "text-border-strong"]} aria-hidden="true">/</span>{item.label.toLowerCase()}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={LINKS.github}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden items-center gap-1.5 rounded-lg border-2 border-border-strong bg-surface px-3.5 py-1.5 text-sm font-medium text-fg shadow-[3px_3px_0_0_var(--chunk-shadow)] transition-all hover:-translate-x-px hover:-translate-y-px hover:text-accent hover:shadow-[4px_4px_0_0_var(--chunk-shadow)] active:translate-x-0.5 active:translate-y-0.5 active:shadow-[1px_1px_0_0_var(--chunk-shadow)] sm:inline-flex"
      >
        <svg class="size-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
        </svg>
        GitHub
      </a>

      <details class="relative md:hidden">
        <summary
          class="inline-flex size-11 cursor-pointer list-none items-center justify-center rounded-lg border-2 border-border-strong bg-surface text-fg hover:text-accent [&::-webkit-details-marker]:hidden"
          aria-label="Open menu"
        >
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M3 6h18M3 12h18M3 18h18"></path>
          </svg>
        </summary>
        <div
          class="absolute right-0 mt-2 w-52 overflow-hidden rounded-lg border-2 border-border-strong bg-surface p-1.5 shadow-[4px_4px_0_0_var(--chunk-shadow)]"
        >
          {
            MAIN_NAV.map((item) => (
              <a
                href={item.href}
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noopener noreferrer" : undefined}
                class:list={[
                  "block rounded-md px-3 py-2 text-sm font-medium transition-colors hover:bg-surface-2",
                  isActive(item.href) ? "text-accent" : "text-fg",
                ]}
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                <span class="text-muted" aria-hidden="true">/</span>{item.label.toLowerCase()}
              </a>
            ))
          }
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    transition: transform 300ms ease;
    will-change: transform;
  }
  /* Slid up out of view when scrolling down; the border keeps it flush. */
  .site-header[data-hidden="true"] {
    transform: translateY(-101%);
  }
  /* Don't snap the bar around for motion-sensitive visitors: keep it put. */
  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }
    .site-header[data-hidden="true"] {
      transform: none;
    }
  }
</style>

<script>
  // Hide the header on scroll-down, reveal it on scroll-up. Always shown near
  // the top of the page, and never hidden while the mobile menu is open.
  function wireAutoHideHeader() {
    const header = document.querySelector<HTMLElement>(".site-header");
    if (!header || header.dataset.autohide === "wired") return;
    header.dataset.autohide = "wired";

    const REVEAL_AT = 80; // px from the top where the bar always shows
    const DELTA = 6; // ignore tiny jitters
    let lastY = window.scrollY;
    let ticking = false;

    function update() {
      ticking = false;
      const y = Math.max(0, window.scrollY);
      const menuOpen = !!header!.querySelector("details[open]");

      if (y <= REVEAL_AT || menuOpen) {
        header!.dataset.hidden = "false";
      } else if (y > lastY + DELTA) {
        header!.dataset.hidden = "true"; // scrolling down
      } else if (y < lastY - DELTA) {
        header!.dataset.hidden = "false"; // scrolling up
      }
      lastY = y;
    }

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          window.requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
  }

  wireAutoHideHeader();
  document.addEventListener("astro:page-load", wireAutoHideHeader);
</script>
