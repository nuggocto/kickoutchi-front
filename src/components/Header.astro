---
import LogoMark from "./LogoMark.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { MAIN_NAV } from "../data/nav";
import { LINKS, SITE } from "../data/links";

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);
const internalNav = MAIN_NAV.filter((item) => !item.external);
---

<header class="sticky top-0 z-50 border-b border-border bg-bg/85 backdrop-blur supports-[backdrop-filter]:bg-bg/70">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3">
    <a href="/" class="group flex items-center gap-2.5" aria-label={`${SITE.name} home`}>
      <LogoMark alt="" width={36} height={36} class="size-9 shrink-0 object-contain" />
      <span class="font-pixel text-xl leading-none tracking-wide">Kickoutchi</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {
        internalNav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "rounded-full px-3.5 py-1.5 text-sm transition-colors hover:bg-surface",
              isActive(item.href) ? "text-accent" : "text-muted hover:text-fg",
            ]}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle />
      <a
        href={LINKS.github}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden items-center gap-1.5 rounded-full border border-border bg-surface px-3.5 py-1.5 text-sm text-fg transition-colors hover:border-accent hover:text-accent sm:inline-flex"
      >
        <svg class="size-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
        </svg>
        GitHub
      </a>

      <details class="relative md:hidden">
        <summary
          class="inline-flex size-9 cursor-pointer list-none items-center justify-center rounded-full border border-border bg-surface text-fg hover:border-accent [&::-webkit-details-marker]:hidden"
          aria-label="Open menu"
        >
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M3 6h18M3 12h18M3 18h18"></path>
          </svg>
        </summary>
        <div
          class="absolute right-0 mt-2 w-52 overflow-hidden rounded-2xl border border-border bg-surface p-1.5"
        >
          {
            MAIN_NAV.map((item) => (
              <a
                href={item.href}
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noopener noreferrer" : undefined}
                class:list={[
                  "block rounded-xl px-3 py-2 text-sm transition-colors hover:bg-surface-2",
                  isActive(item.href) ? "text-accent" : "text-fg",
                ]}
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </details>
    </div>
  </div>
</header>
