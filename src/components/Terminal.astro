---
export interface TerminalLine {
  text: string;
  kind?: "command" | "output" | "comment" | "success" | "warning" | "muted";
  /** Prompt shown before a command line (visual only). */
  prompt?: string;
}

interface Props {
  title?: string;
  lines: TerminalLine[];
  /** Type the session out when it scrolls into view (falls back to static). */
  animate?: boolean;
  class?: string;
}

const { title = "kick • local ports", lines, animate = false, class: className = "" } =
  Astro.props;
---

<figure
  class:list={["terminal overflow-hidden rounded-lg border-2 border-border-strong", className]}
  data-animate={animate ? "true" : undefined}
>
  <figcaption class="chrome flex items-center justify-between gap-2 px-3 py-2 sm:px-4 sm:py-2.5">
    <div class="flex items-center gap-2 sm:gap-2.5">
      <span class="terminal-icon" aria-hidden="true">
        <span class="terminal-caret"></span>
      </span>
      <span class="font-mono text-xs">{title}</span>
    </div>
    <span class="hidden font-mono text-xs tracking-wider opacity-60 sm:inline" aria-hidden="true">
      80×24
    </span>
  </figcaption>
  <div class="screen crt-overlay overflow-hidden px-3 py-3 font-mono text-xs leading-relaxed sm:px-4 sm:py-4 sm:text-sm">
    <pre class="whitespace-pre-wrap"><code>{lines.map((line) => (
        <span class:list={["line", `is-${line.kind ?? "output"}`]}>{line.kind === "command" && <span class="prompt">{line.prompt ?? "$"} </span>}<span class="content">{line.text}</span></span>
      ))}</code></pre>
  </div>
</figure>

<style>
  /* A real terminal is dark — an intentional "device screen" focal point on
     the light page. */
  .terminal {
    --term-bg: #0b0d08;
    --term-chrome: #141810;
    --term-fg: #d7dcc4;
    --term-prompt: #b7d073;
    --term-comment: #7e8a6a;
    --term-muted: #8a8f7e;
    --term-success: #9fd07a;
    --term-warning: #e0b357;
    background-color: var(--term-bg);
    box-shadow: 5px 5px 0 0 var(--chunk-shadow);
  }
  .chrome {
    background-color: var(--term-chrome);
    color: var(--term-muted);
    border-bottom: 2px solid var(--border-strong);
  }
  .terminal-icon {
    display: inline-flex;
    height: 0.95rem;
    width: 0.95rem;
    align-items: center;
    justify-content: center;
    border: 1px solid #303725;
    border-radius: 0.25rem;
    background-color: #0d100a;
  }
  .terminal-caret {
    height: 0.35rem;
    width: 0.35rem;
    border-right: 2px solid var(--term-prompt);
    border-bottom: 2px solid var(--term-prompt);
    transform: rotate(-45deg);
  }
  .screen {
    color: var(--term-fg);
    /* Soft phosphor glow behind the text. */
    background:
      radial-gradient(120% 90% at 50% 0%, rgb(183 208 115 / 0.06), transparent 70%),
      var(--term-bg);
  }
  /* Inside `.prose` (the docs body), the global `pre` rule would paint a light
     card over the screen and leave light-on-dark text unreadable. The terminal
     owns its own chrome, so neutralize those properties here rather than
     carving an exception into the prose styles. */
  .screen pre {
    margin: 0;
    font: inherit;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
    overflow-x: visible;
  }
  .line {
    display: block;
    white-space: pre-wrap;
  }
  /* Lines hidden only once the typing script takes over (no-JS stays static). */
  .line[data-pending] {
    display: none;
  }
  .content {
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .prompt {
    color: var(--term-prompt);
    font-weight: 600;
  }
  .is-command .content {
    color: var(--term-fg);
  }
  .is-comment {
    color: var(--term-comment);
  }
  .is-muted {
    color: var(--term-muted);
  }
  .is-success {
    color: var(--term-success);
  }
  .is-warning {
    color: var(--term-warning);
  }
</style>

<script>
  // Progressive "someone is typing" replay for terminals marked data-animate.
  // The static markup stays intact for no-JS and reduced-motion visitors.
  const REDUCED = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function animateTerminal(terminal: HTMLElement) {
    const lineEls = [...terminal.querySelectorAll<HTMLElement>(".line")];
    if (lineEls.length === 0) return;

    const steps = lineEls.map((el) => {
      const content = el.querySelector<HTMLElement>(".content");
      return {
        el,
        content,
        text: content?.textContent ?? "",
        isCommand: el.classList.contains("is-command"),
      };
    });

    for (const step of steps) {
      step.el.setAttribute("data-pending", "");
      if (step.isCommand && step.content) step.content.textContent = "";
    }

    const cursor = document.createElement("span");
    cursor.className = "type-cursor";
    cursor.textContent = "▮";
    cursor.setAttribute("aria-hidden", "true");

    let index = 0;

    function nextStep() {
      if (index >= steps.length) {
        cursor.remove();
        return;
      }
      const step = steps[index++];
      step.el.removeAttribute("data-pending");

      if (step.isCommand && step.content) {
        step.content.textContent = "";
        step.content.appendChild(cursor);
        let chars = 0;
        const typeChar = () => {
          chars += 1;
          step.content!.textContent = step.text.slice(0, chars);
          step.content!.appendChild(cursor);
          if (chars < step.text.length) {
            window.setTimeout(typeChar, 14 + Math.random() * 26);
          } else {
            window.setTimeout(nextStep, 240);
          }
        };
        window.setTimeout(typeChar, 260);
      } else {
        // Output arrives in quick bursts, like a real program printing.
        window.setTimeout(nextStep, 34 + Math.random() * 46);
      }
    }

    nextStep();
  }

  function wireTerminals() {
    const terminals = document.querySelectorAll<HTMLElement>(
      ".terminal[data-animate]:not([data-wired])",
    );
    for (const terminal of terminals) {
      terminal.dataset.wired = "true";
      if (REDUCED || !("IntersectionObserver" in window)) continue;
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              observer.disconnect();
              animateTerminal(terminal);
            }
          }
        },
        { threshold: 0.35 },
      );
      observer.observe(terminal);
    }
  }

  wireTerminals();
  document.addEventListener("astro:page-load", wireTerminals);
</script>
