---
export interface TerminalLine {
  text: string;
  kind?: "command" | "output" | "comment" | "success" | "warning" | "muted";
  /** Prompt shown before a command line (visual only). */
  prompt?: string;
}

interface Props {
  title?: string;
  lines: TerminalLine[];
  class?: string;
}

const { title = "kick • local ports", lines, class: className = "" } = Astro.props;
---

<figure class:list={["terminal overflow-hidden rounded-lg border-2 border-border-strong", className]}>
  <figcaption class="chrome flex items-center justify-between gap-2 px-3 py-2 sm:px-4 sm:py-2.5">
    <div class="flex items-center gap-2 sm:gap-2.5">
      <span class="terminal-icon" aria-hidden="true">
        <span class="terminal-caret"></span>
      </span>
      <span class="font-mono text-sm">{title}</span>
    </div>
    <span class="hidden font-mono text-sm tracking-wider opacity-60 sm:inline" aria-hidden="true">
      80×24
    </span>
  </figcaption>
  <div class="screen crt-overlay overflow-hidden px-3 py-3 font-mono text-sm leading-relaxed sm:px-4 sm:py-4">
    <pre class="whitespace-pre-wrap"><code>{lines.map((line) => (
        <span class:list={["line", `is-${line.kind ?? "output"}`]}>{line.kind === "command" && <span class="prompt">{line.prompt ?? "$"} </span>}<span class="content">{line.text}</span></span>
      ))}</code></pre>
  </div>
</figure>

<style>
  /* A terminal screen in the shared terminal palette (global.css). */
  .terminal {
    --term-chrome: var(--surface);
    --term-prompt: var(--term-accent);
    --term-comment: var(--term-dim);
    --term-muted: var(--term-out);
    --term-success: var(--term-accent);
    --term-warning: #e0b357;
    background-color: var(--term-bg);
    box-shadow: 5px 5px 0 0 var(--drop);
  }
  .chrome {
    background-color: var(--term-chrome);
    color: var(--term-muted);
    border-bottom: 2px solid var(--border-strong);
  }
  .terminal-icon {
    display: inline-flex;
    height: 0.95rem;
    width: 0.95rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-strong);
    border-radius: 0.25rem;
    background-color: var(--term-bg);
  }
  .terminal-caret {
    height: 0.35rem;
    width: 0.35rem;
    border-right: 2px solid var(--term-prompt);
    border-bottom: 2px solid var(--term-prompt);
    transform: rotate(-45deg);
  }
  .screen {
    color: var(--term-fg);
    background: var(--term-bg);
  }
  /* Inside `.prose` (the docs body), the global `pre` rule would paint a light
     card over the screen and leave light-on-dark text unreadable. The terminal
     owns its own chrome, so neutralize those properties here rather than
     carving an exception into the prose styles. */
  .screen pre {
    min-width: 0;
    margin: 0;
    font: inherit;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
    overflow-x: visible;
  }
  .line {
    display: block;
    white-space: pre-wrap;
  }
  .content {
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .prompt {
    color: var(--term-prompt);
    font-weight: 600;
  }
  .is-command .content {
    color: var(--term-fg);
  }
  .is-comment {
    color: var(--term-comment);
  }
  .is-muted {
    color: var(--term-muted);
  }
  .is-success {
    color: var(--term-success);
  }
  .is-warning {
    color: var(--term-warning);
  }
</style>
