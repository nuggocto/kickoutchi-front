---
import CopyButton from "./CopyButton.astro";

interface Props {
  code: string;
  /** Affects only the copy affordance label; commands aren't syntax-highlighted. */
  lang?: "sh" | "powershell" | "toml" | "json" | "text";
  label?: string;
  class?: string;
}

const { code, lang = "sh", label, class: className = "" } = Astro.props;
const langLabel: Record<NonNullable<Props["lang"]>, string> = {
  sh: "shell",
  powershell: "powershell",
  toml: "toml",
  json: "json",
  text: "text",
};
---

<figure class:list={["group not-prose overflow-hidden rounded-xl border border-border bg-surface", className]}>
  <figcaption class="flex items-center justify-between gap-3 border-b border-border bg-surface-2/60 px-3 py-1.5">
    <span class="font-mono text-[0.7rem] uppercase tracking-wider text-muted">
      {label ?? langLabel[lang]}
    </span>
    <CopyButton text={code} />
  </figcaption>
  <pre class="px-4 py-3 text-sm leading-relaxed whitespace-pre-wrap"><code class="font-mono text-fg break-words [overflow-wrap:anywhere]">{code}</code></pre>
</figure>
