---
interface Props {
  type?: "note" | "tip" | "warning" | "danger" | "safety";
  title?: string;
  class?: string;
}

const { type = "note", title, class: className = "" } = Astro.props;

const config: Record<
  NonNullable<Props["type"]>,
  { label: string; box: string; iconWrap: string; icon: string }
> = {
  note: {
    label: "Note",
    box: "border-border bg-surface",
    iconWrap: "text-muted",
    icon: "M12 16v-4M12 8h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z",
  },
  tip: {
    label: "Tip",
    box: "border-accent/40 bg-accent/10",
    iconWrap: "text-accent",
    icon: "M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.3 1 2.1h6c0-.8.4-1.6 1-2.1A7 7 0 0 0 12 2z",
  },
  warning: {
    label: "Watch out",
    box: "border-warning/45 bg-warning-soft",
    iconWrap: "text-warning",
    icon: "M10.3 3.6 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.6a2 2 0 0 0-3.4 0zM12 9v4M12 17h.01",
  },
  danger: {
    label: "Danger",
    box: "border-danger/45 bg-danger-soft",
    iconWrap: "text-danger",
    icon: "M12 9v4M12 17h.01M10.3 3.6 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.6a2 2 0 0 0-3.4 0z",
  },
  safety: {
    label: "Safety",
    box: "border-accent/40 bg-accent/10",
    iconWrap: "text-accent",
    icon: "M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10zM9 12l2 2 4-4",
  },
};

const c = config[type];
---

<aside class:list={["not-prose flex gap-3 rounded-xl border p-4", c.box, className]} role="note">
  <svg
    class:list={["mt-0.5 size-5 shrink-0", c.iconWrap]}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d={c.icon}></path>
  </svg>
  <div class="min-w-0 text-sm leading-relaxed">
    <p class="mb-1 font-semibold text-fg">{title ?? c.label}</p>
    <div class="text-muted [&_a]:text-accent [&_a:hover]:underline [&_code]:font-mono [&_code]:text-fg">
      <slot />
    </div>
  </div>
</aside>
