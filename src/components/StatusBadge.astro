---
import type { Status } from "../lib/schemas";
import { STATUS_LABELS } from "../lib/schemas";

interface Props {
  status: Status;
  class?: string;
}
const { status, class: className = "" } = Astro.props;

// Shape + label carry the meaning too, so status is never colour-only.
const styles: Record<Status, string> = {
  available: "border-accent/40 bg-accent/10 text-accent",
  "coming-soon": "border-warning/45 bg-warning-soft text-warning",
  paused: "border-warning/45 bg-warning-soft text-warning",
  "not-planned": "border-border bg-surface-2 text-muted",
};
const marks: Record<Status, string> = {
  available: "●",
  "coming-soon": "◔",
  paused: "Ⅱ",
  "not-planned": "○",
};
---

<span
  class:list={[
    "inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-sm font-medium",
    styles[status],
    className,
  ]}
>
  <span aria-hidden="true">{marks[status]}</span>
  {STATUS_LABELS[status]}
</span>
