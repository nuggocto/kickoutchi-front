---
import CommandBlock from "./CommandBlock.astro";
import StatusBadge from "./StatusBadge.astro";
import Callout from "./Callout.astro";
import type { InstallMethod } from "../data/install-methods";
import { PLATFORM_LABELS } from "../lib/schemas";

interface Props {
  method: InstallMethod;
  class?: string;
}
const { method, class: className = "" } = Astro.props;
const dimmed = method.status === "not-planned";
const platformLabels = method.platforms.map((p) => PLATFORM_LABELS[p]).join(" • ");
const showStatus = method.status !== "available";
const noteType = method.status === "coming-soon" || method.status === "paused" ? "warning" : "note";
---

<article
  id={method.id}
  class:list={[
    "pocket-panel scroll-mt-24 p-6",
    dimmed && "opacity-80",
    className,
  ]}
>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h3 class="text-lg font-semibold text-fg">{method.name}</h3>
      <p class="mt-0.5 font-mono text-xs text-muted">{platformLabels}</p>
    </div>
    {showStatus && <StatusBadge status={method.status} />}
  </div>

  <p class="mt-3 text-sm leading-relaxed text-muted">{method.summary}</p>

  {
    method.commands.length > 0 && (
      <div class="mt-4 space-y-3">
        {method.commands.map((command) => (
          <CommandBlock code={command.code} lang={command.lang} label={command.label} />
        ))}
      </div>
    )
  }

  {
    method.note && (
      <Callout type={noteType} class="mt-4">
        {method.note}
      </Callout>
    )
  }
</article>
