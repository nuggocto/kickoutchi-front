---
import mark from "../assets/logo/mark-light.png";

interface Props {
  alt?: string;
  class?: string;
  width?: number;
  height?: number;
  priority?: boolean;
}

const {
  alt = "",
  class: className = "",
  width,
  height,
  priority = false,
} = Astro.props;
---

<img
  src={mark.src}
  alt={alt}
  class:list={["logo-mark", className]}
  data-pixel
  width={width ?? mark.width}
  height={height ?? mark.height}
  loading={priority ? "eager" : "lazy"}
  fetchpriority={priority ? "high" : undefined}
/>
