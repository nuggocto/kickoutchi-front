---
import { Image } from "astro:assets";
import markDark from "../assets/logo/mark-dark.png";
import markWhite from "../assets/logo/mark-white.png";

interface Props {
  alt?: string;
  class?: string;
  widths?: number[];
  sizes?: string;
  width?: number;
  height?: number;
  priority?: boolean;
}

const {
  alt = "",
  class: className = "",
  widths,
  sizes,
  width,
  height,
  priority = false,
} = Astro.props;
const imageProps = {
  widths,
  sizes,
  width,
  height,
  loading: priority ? "eager" : undefined,
  fetchpriority: priority ? "high" : undefined,
} as const;
---

<Image
  src={markDark}
  alt={alt}
  class:list={["logo-mark logo-mark--light", className]}
  data-pixel
  {...imageProps}
/>
<Image
  src={markWhite}
  alt={alt}
  class:list={["logo-mark logo-mark--dark", className]}
  data-pixel
  {...imageProps}
/>

<style>
  .logo-mark--dark {
    display: none;
  }
  :global([data-theme="dark"]) .logo-mark--dark {
    display: block;
  }
  :global([data-theme="dark"]) .logo-mark--light {
    display: none;
  }
</style>
