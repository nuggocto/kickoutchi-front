---
import markDark from "../assets/logo/mark-dark.png";
import markWhite from "../assets/logo/mark-white.png";

interface Props {
  alt?: string;
  class?: string;
  width?: number;
  height?: number;
  priority?: boolean;
}

const {
  alt = "",
  class: className = "",
  width,
  height,
  priority = false,
} = Astro.props;
---

<img
  src={markDark.src}
  alt={alt}
  class:list={["logo-mark logo-mark--light", className]}
  data-pixel
  width={width ?? markDark.width}
  height={height ?? markDark.height}
  loading={priority ? "eager" : "lazy"}
  fetchpriority={priority ? "high" : undefined}
/>
<img
  src={markWhite.src}
  alt={alt}
  class:list={["logo-mark logo-mark--dark", className]}
  data-pixel
  width={width ?? markWhite.width}
  height={height ?? markWhite.height}
  loading={priority ? "eager" : "lazy"}
  fetchpriority={priority ? "high" : undefined}
/>

<style>
  .logo-mark--dark {
    display: none;
  }
  :global([data-theme="dark"]) .logo-mark--dark {
    display: block;
  }
  :global([data-theme="dark"]) .logo-mark--light {
    display: none;
  }
</style>
