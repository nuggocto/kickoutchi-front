---
import { docHref, type DocEntry } from "../lib/docs";

interface Props {
  prev?: DocEntry;
  next?: DocEntry;
}
const { prev, next } = Astro.props;
---

<nav class="mt-12 grid gap-3 border-t border-border pt-6 sm:grid-cols-2" aria-label="Docs pagination">
  {
    prev ? (
      <a
        href={docHref(prev)}
        class="group rounded-xl border border-border bg-surface p-4 transition-colors hover:border-accent"
      >
        <span class="text-xs text-muted">← Previous</span>
        <span class="mt-0.5 block font-medium text-fg group-hover:text-accent">{prev.data.title}</span>
      </a>
    ) : (
      <span></span>
    )
  }
  {
    next ? (
      <a
        href={docHref(next)}
        class="group rounded-xl border border-border bg-surface p-4 text-right transition-colors hover:border-accent sm:col-start-2"
      >
        <span class="text-xs text-muted">Next →</span>
        <span class="mt-0.5 block font-medium text-fg group-hover:text-accent">{next.data.title}</span>
      </a>
    ) : (
      <span></span>
    )
  }
</nav>
