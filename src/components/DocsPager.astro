---
import { docHref, type DocEntry } from "../lib/docs";

interface Props {
  prev?: DocEntry;
  next?: DocEntry;
}
const { prev, next } = Astro.props;
---

<nav class="mt-12 grid gap-4 border-t-2 border-dashed border-border-strong pt-8 sm:grid-cols-2" aria-label="Docs pagination">
  {
    prev ? (
      <a
        href={docHref(prev)}
        class="group pocket-panel pocket-panel-hover p-4"
      >
        <span class="font-pixel text-sm text-faint">← Previous</span>
        <span class="mt-0.5 block font-medium text-fg group-hover:text-accent">{prev.data.title}</span>
      </a>
    ) : (
      <span></span>
    )
  }
  {
    next ? (
      <a
        href={docHref(next)}
        class="group pocket-panel pocket-panel-hover p-4 text-right sm:col-start-2"
      >
        <span class="font-pixel text-sm text-faint">Next →</span>
        <span class="mt-0.5 block font-medium text-fg group-hover:text-accent">{next.data.title}</span>
      </a>
    ) : (
      <span></span>
    )
  }
</nav>
