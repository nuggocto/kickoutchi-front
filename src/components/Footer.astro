---
import LogoMark from "./LogoMark.astro";
import { FOOTER_NAV } from "../data/nav";
import { LINKS, SITE } from "../data/links";

const year = new Date().getFullYear();
---

<footer class="mt-16 border-t-2 border-border-strong bg-surface/40 sm:mt-20">
  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="grid grid-cols-2 gap-x-6 gap-y-8 lg:grid-cols-4 lg:gap-10">
      <div class="space-y-3">
        <a href="/" class="flex items-center gap-2.5" aria-label={`${SITE.name} home`}>
          <LogoMark alt="" width={32} height={32} class="size-8 object-contain" />
          <span class="font-pixel text-lg leading-none tracking-wide">Kickoutchi</span>
        </a>
        <p class="max-w-xs text-sm text-muted">
          A cross-platform TUI and CLI port janitor that shows what owns each local port before you
          clear it.
        </p>
      </div>

      {
        FOOTER_NAV.map((group) => (
          <div>
            <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-accent">{group.title}</h2>
            <ul class="space-y-2">
              {group.items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    target={item.external ? "_blank" : undefined}
                    rel={item.external ? "noopener noreferrer" : undefined}
                    class="text-sm text-muted transition-colors hover:text-accent"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="mt-10 flex flex-col gap-3 border-t border-border pt-6 text-sm text-muted sm:flex-row sm:items-center sm:justify-between"
    >
      <p>
        © {year} {SITE.name}, released under the{" "}
        <a href={LINKS.license} target="_blank" rel="noopener noreferrer" class="text-fg underline underline-offset-2 hover:text-accent">MIT License</a>{" "}
        and built in the swamp.
      </p>
      <p class="flex items-center gap-2">
        <span class="font-mono text-sm text-muted">v{SITE.version}</span>
        <span aria-hidden="true">•</span>
        <a href={LINKS.github} target="_blank" rel="noopener noreferrer" class="hover:text-accent">
          github.com/nuggocto/kickoutchi
        </a>
      </p>
    </div>
  </div>

  <!-- Giant pixel sign-off. Fully visible: normal leading so the glyphs fit,
       flex centering so any horizontal overflow stays symmetric, and bottom
       padding so the word breathes above the page edge. -->
  <div class="pointer-events-none flex select-none justify-center overflow-hidden px-4 pb-8" aria-hidden="true">
    <p class="font-pixel text-[clamp(2.5rem,9.5vw,8rem)] leading-none tracking-tight text-fg/[0.08] whitespace-nowrap">
      KICKOUTCHI
    </p>
  </div>
</footer>
