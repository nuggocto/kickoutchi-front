---
import Layout from "./Layout.astro";
import DocsSidebar from "../components/DocsSidebar.astro";
import DocsPager from "../components/DocsPager.astro";
import { getDocs, getDocGroups, type DocEntry } from "../lib/docs";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  mode?: "general" | "tui" | "cli";
  id?: string;
  headings?: Heading[];
}

const { title, description, mode = "general", id, headings = [] } = Astro.props;

const groups = await getDocGroups();
const docs = await getDocs();
const index = id ? docs.findIndex((doc) => doc.id === id) : -1;
const prev: DocEntry | undefined = index > 0 ? docs[index - 1] : undefined;
const next: DocEntry | undefined =
  index >= 0 && index < docs.length - 1 ? docs[index + 1] : undefined;

const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const modeLabel: Record<NonNullable<Props["mode"]>, string | null> = {
  general: null,
  tui: "TUI",
  cli: "CLI",
};
---

<Layout title={title} description={description}>
  <div class="mx-auto grid max-w-7xl gap-8 px-4 py-8 lg:grid-cols-[15rem_minmax(0,1fr)] xl:grid-cols-[15rem_minmax(0,1fr)_13rem]">
    <!-- Desktop sidebar -->
    <aside class="hidden lg:block">
      <div class="sticky top-20 max-h-[calc(100dvh-6rem)] overflow-y-auto pb-8">
        <DocsSidebar groups={groups} currentId={id} />
      </div>
    </aside>

    <article class="min-w-0">
      <!-- Mobile docs menu -->
      <details class="mb-6 rounded-xl border border-border bg-surface lg:hidden">
        <summary class="cursor-pointer list-none px-4 py-3 text-sm font-medium [&::-webkit-details-marker]:hidden">
          <span class="flex items-center justify-between">
            Documentation menu
            <svg class="size-4 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
          </span>
        </summary>
        <div class="border-t border-border px-4 py-3">
          <DocsSidebar groups={groups} currentId={id} />
        </div>
      </details>

      <nav class="mb-4 flex items-center gap-1.5 text-sm text-muted" aria-label="Breadcrumb">
        <a href="/docs" class="hover:text-accent">Docs</a>
        <span aria-hidden="true">/</span>
        <span class="text-fg">{title}</span>
      </nav>

      <header class="mb-8 border-b border-border pb-6">
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
          {
            modeLabel[mode] && (
              <span class="rounded-full border border-accent/40 bg-accent/10 px-2.5 py-0.5 font-mono text-xs text-accent">
                {modeLabel[mode]}
              </span>
            )
          }
        </div>
        <p class="mt-3 text-lg text-muted">{description}</p>
      </header>

      <div class="prose max-w-none">
        <slot />
      </div>

      <DocsPager prev={prev} next={next} />
    </article>

    <!-- On-page TOC -->
    {
      toc.length > 0 && (
        <aside class="hidden xl:block">
          <div class="sticky top-20 max-h-[calc(100dvh-6rem)] overflow-y-auto pb-8">
            <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-muted/80">On this page</p>
            <ul class="space-y-1.5 text-sm" id="toc">
              {toc.map((heading) => (
                <li class={heading.depth === 3 ? "pl-3" : ""}>
                  <a
                    href={`#${heading.slug}`}
                    data-toc-link={heading.slug}
                    class="block text-muted transition-colors hover:text-fg"
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      )
    }
  </div>
</Layout>

<script>
  // Lightweight scrollspy for the on-page table of contents.
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]");
  if (links.length > 0) {
    const byId = new Map<string, HTMLAnchorElement>();
    for (const link of links) byId.set(link.dataset.tocLink ?? "", link);
    const headings = Array.from(byId.keys())
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    const setActive = (id: string) => {
      for (const link of links) {
        const active = link.dataset.tocLink === id;
        link.classList.toggle("text-accent", active);
        link.classList.toggle("font-medium", active);
        link.classList.toggle("text-muted", !active);
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) setActive(entry.target.id);
        }
      },
      { rootMargin: "-80px 0px -70% 0px", threshold: 0 },
    );
    for (const heading of headings) observer.observe(heading);
  }
</script>
