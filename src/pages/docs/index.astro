---
import Layout from "../../layouts/Layout.astro";
import DocsSidebar from "../../components/DocsSidebar.astro";
import Callout from "../../components/Callout.astro";
import { getDocGroups, docHref } from "../../lib/docs";
import { LINKS } from "../../data/links";

const groups = await getDocGroups();
---

<Layout
  title="Documentation"
  description="Learn Kickoutchi: the guided TUI, the scriptable CLI, the command reference, config, safety, and troubleshooting."
>
  <div class="mx-auto grid max-w-7xl gap-8 px-4 py-8 lg:grid-cols-[15rem_minmax(0,1fr)]">
    <aside class="hidden lg:block">
      <div class="sticky top-20 max-h-[calc(100dvh-6rem)] overflow-y-auto pb-8">
        <DocsSidebar groups={groups} currentId={undefined} />
      </div>
    </aside>

    <article class="min-w-0">
      <header class="mb-8 border-b border-border pb-6">
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Documentation</h1>
        <p class="mt-3 max-w-2xl text-lg text-muted">
          Kickoutchi shows what's squatting on your local ports and helps you kick stale dev
          servers out safely. Two ways through the swamp • pick yours.
        </p>
      </header>

      <div class="grid gap-5 sm:grid-cols-2">
        <a href="/docs/tui" class="pocket-panel group p-6 transition-colors hover:border-accent/50">
          <p class="font-pixel text-xs uppercase tracking-widest text-muted">The cozy way</p>
          <h2 class="mt-1 text-xl font-semibold text-fg group-hover:text-accent">TUI walkthrough</h2>
          <p class="mt-2 text-sm text-muted">
            Open the terminal UI and let Kickoutchi walk you through the swamp • browse, search,
            sort, and kick with live details and confirmations.
          </p>
        </a>
        <a href="/docs/cli" class="pocket-panel group p-6 transition-colors hover:border-accent/50">
          <p class="font-pixel text-xs uppercase tracking-widest text-muted">The goblin-speed way</p>
          <h2 class="mt-1 text-xl font-semibold text-fg group-hover:text-accent">CLI walkthrough</h2>
          <p class="mt-2 text-sm text-muted">
            Use the CLI when you already know which port needs a tiny boot. Tables, stable JSON,
            precise filters, and a fixed exit-code contract.
          </p>
        </a>
      </div>

      <Callout type="tip" class="mt-6" title="In a hurry?">
        The <a href="/docs/commands">command reference</a> is the compact index for people who
        already know what they need.
      </Callout>

      {
        groups.map((group) => (
          <section class="mt-10">
            <h2 class="mb-4 text-lg font-semibold text-fg">{group.section}</h2>
            <ul class="grid gap-3 sm:grid-cols-2">
              {group.items.map((item) => (
                <li>
                  <a
                    href={docHref(item)}
                    class="group flex h-full flex-col rounded-xl border border-border bg-surface p-4 transition-colors hover:border-accent"
                  >
                    <span class="font-medium text-fg group-hover:text-accent">{item.data.title}</span>
                    <span class="mt-1 text-sm text-muted">{item.data.description}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }

      <div class="mt-10 rounded-xl border border-border bg-surface-2/40 p-5 text-sm text-muted">
        These docs track real <code class="font-mono text-fg">kickoutchi</code> behaviour. Found a
        gap? <a href={LINKS.issues} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">Open an issue</a>.
      </div>
    </article>
  </div>
</Layout>
