---
import Layout from "../../layouts/Layout.astro";
import DocsSidebar from "../../components/DocsSidebar.astro";
import Callout from "../../components/Callout.astro";
import { getDocGroups, docHref } from "../../lib/docs";
import { LINKS } from "../../data/links";

const groups = await getDocGroups();
const featuredIds = new Set(["tui", "cli", "watch-and-why", "scoped-kills"]);
const remainingGroups = groups
  .map((group) => ({
    ...group,
    items: group.items.filter((item) => !featuredIds.has(item.id)),
  }))
  .filter((group) => group.items.length > 0);
---

<Layout
  title="Documentation"
  description="Learn Kickoutchi: the guided TUI, the scriptable CLI, watch and why, scoped kills, command reference, config, safety, and troubleshooting."
>
  <div class="mx-auto grid max-w-7xl gap-8 px-4 py-8 lg:grid-cols-[15rem_minmax(0,1fr)]">
    <aside class="hidden lg:block">
      <div class="sticky top-20 max-h-[calc(100dvh-6rem)] overflow-y-auto pb-8">
        <DocsSidebar groups={groups} currentId={undefined} />
      </div>
    </aside>

    <article class="min-w-0">
      <header class="mb-8 border-b border-border pb-6">
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Documentation</h1>
        <p class="mt-3 max-w-2xl text-lg text-muted">
          Start with an interface, a read-only diagnostic, or a termination guide. The reference
          pages cover exact syntax, config, output contracts, and failure cases.
        </p>
      </header>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        <a href="/docs/tui" class="pocket-panel pocket-panel-hover group p-6">
          <p class="font-pixel text-xs uppercase tracking-widest text-accent">The swamp tour</p>
          <h2 class="mt-1 text-xl font-semibold text-fg group-hover:text-accent">TUI walkthrough</h2>
          <p class="mt-2 text-sm text-muted">
            Browse and filter the live port table, open process details, and confirm one-process or
            tree cleanup.
          </p>
        </a>
        <a href="/docs/cli" class="pocket-panel pocket-panel-hover group p-6">
          <p class="font-pixel text-xs uppercase tracking-widest text-accent">The swamp shortcut</p>
          <h2 class="mt-1 text-xl font-semibold text-fg group-hover:text-accent">CLI walkthrough</h2>
          <p class="mt-2 text-sm text-muted">
            Run headless commands for tables, stable JSON, exact filters, process inspection, and
            scoped termination.
          </p>
        </a>
        <a href="/docs/watch-and-why" class="pocket-panel pocket-panel-hover group p-6">
          <p class="font-pixel text-xs uppercase tracking-widest text-accent">Look, don't touch</p>
          <h2 class="mt-1 text-xl font-semibold text-fg group-hover:text-accent">Watch &amp; Why</h2>
          <p class="mt-2 text-sm text-muted">
            Observe socket changes or probe a failed bind. Both return evidence without sending
            signals.
          </p>
        </a>
        <a href="/docs/scoped-kills" class="pocket-panel pocket-panel-hover group p-6">
          <p class="font-pixel text-xs uppercase tracking-widest text-accent">The big green boot</p>
          <h2 class="mt-1 text-xl font-semibold text-fg group-hover:text-accent">Scoped kills</h2>
          <p class="mt-2 text-sm text-muted">
            Inspect first, then use tree kill for dev stacks that leave workers behind. Linux/macOS
            also include process-group kill for POSIX groups.
          </p>
        </a>
      </div>

      <Callout type="tip" class="mt-6" title="In a hurry?">
        The <a href="/docs/commands">command reference</a> lists every flag, filter, output mode,
        and exit code.
      </Callout>

      {
        remainingGroups.map((group) => (
          <section class="mt-10">
            <h2 class="mb-4 text-lg font-semibold text-fg">{group.section}</h2>
            <ul class="grid gap-3 sm:grid-cols-2">
              {group.items.map((item) => (
                <li>
                  <a
                    href={docHref(item)}
                    class="group flex h-full flex-col rounded-xl border border-border bg-surface p-4 transition-colors hover:border-accent"
                  >
                    <span class="font-medium text-fg group-hover:text-accent">{item.data.title}</span>
                    <span class="mt-1 text-sm text-muted">{item.data.description}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }

      <div class="mt-10 rounded-xl border border-border bg-surface-2/40 p-5 text-sm text-muted">
        Found an incorrect command, option, or output field? <a href={LINKS.issues} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">Open an issue</a>.
      </div>
    </article>
  </div>
</Layout>
