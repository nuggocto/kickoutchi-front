---
import LogoMark from "../components/LogoMark.astro";
import Layout from "../layouts/Layout.astro";
import ButtonLink from "../components/ButtonLink.astro";
---

<Layout title="Page not found" noindex>
  <section class="mx-auto flex max-w-xl flex-col items-center px-4 py-24 text-center">
    <LogoMark alt="" width={96} height={96} class="mb-6 size-24 object-contain" />
    <p class="font-pixel text-5xl text-accent">404</p>
    <h1 class="mt-3 text-2xl font-bold tracking-tight">Nothing's listening here</h1>
    <p class="mt-3 text-muted">
      This corner of the swamp is empty • the page you wanted moved on or never existed.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <ButtonLink href="/">Back home</ButtonLink>
      <ButtonLink href="/docs" variant="secondary">Read the docs</ButtonLink>
    </div>
  </section>
</Layout>
