---
import Layout from "../layouts/Layout.astro";
import ButtonLink from "../components/ButtonLink.astro";
import CommandBlock from "../components/CommandBlock.astro";
import Terminal from "../components/Terminal.astro";
import type { TerminalLine } from "../components/Terminal.astro";
import PocketDevice from "../components/PocketDevice.astro";
import QuickInstall from "../components/QuickInstall.astro";
import { LINKS, SITE } from "../data/links";

const demo: TerminalLine[] = [
  { kind: "command", text: "kick inspect --port 3000" },
  { kind: "output", text: "Target: PID 18422 (node)" },
  { kind: "output", text: "Tree (3 processes):" },
  { kind: "output", text: "  PID 18422 (node) [TCP 127.0.0.1:3000]" },
  { kind: "output", text: "    PID 18431 (vite)" },
  { kind: "output", text: "    PID 18444 (esbuild)" },
  { kind: "muted", text: "To terminate this tree:" },
  { kind: "muted", text: "kick kill --pid 18422 --tree" },
];
const tasks = [
  { number: "01", title: "Find the owner", description: "Port 3000 is busy. See the process behind it before deciding what to stop.", command: "kick list --port 3000", href: "/docs/cli", link: "List and filter ports" },
  { number: "02", title: "Explain the conflict", description: 'Get evidence behind "address already in use", even when the owner is unclear.', command: "kick why 3000", href: "/docs/watch-and-why", link: "Understand bind failures" },
  { number: "03", title: "Watch it change", description: "Keep an eye on ports as servers start, stop, or get replaced.", command: "kick watch", href: "/docs/watch-and-why", link: "Watch ports live" },
];
---

<Layout>
  <section class="mx-auto max-w-6xl px-4 pt-10 pb-12 sm:pt-16 sm:pb-16">
    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-[1.3fr_0.7fr] lg:gap-14">
      <div class="min-w-0">
        <a href={`/changelog#v${SITE.version}`} class="text-sm text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent">
          v{SITE.version} is out. Faster JSON output, lower idle CPU →
        </a>
        <h1 class="mt-6 text-[2.6rem] leading-[1.05] font-bold tracking-tight sm:text-6xl">
          Your ports have squatters,
          <span class="mt-3 block font-pixel font-medium text-kick">so kick them out.</span>
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">
          Find what's using your port. Inspect the process, then clear the stale server from your terminal.
        </p>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          Free, open-source TUI &amp; CLI. Linux, macOS, and Windows.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <ButtonLink href="#quick-install">Install Kickoutchi</ButtonLink>
          <ButtonLink href="#see-it" variant="secondary">See it in action ↓</ButtonLink>
        </div>
        <div class="mt-8 border-t border-border pt-6">
          <QuickInstall />
        </div>
      </div>
      <div class="hero-device">
        <PocketDevice />
      </div>
    </div>
  </section>

  <section id="see-it" class="scroll-mt-20 border-y-2 border-border-strong bg-surface/60">
    <div class="mx-auto max-w-6xl px-4 py-10 sm:py-14">
      <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <p class="pixel-label">Inside your terminal</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Meet your port janitor.</h2>
          <p class="mt-3 max-w-xl leading-relaxed text-muted">Browse open ports, select a process, and see exactly what owns it.</p>
        </div>
        <a href="/docs/tui" class="shrink-0 text-sm font-semibold text-accent underline underline-offset-4">Take the TUI tour →</a>
      </div>
      <figure class="mt-7">
        <div class="overflow-hidden rounded-lg border-2 border-border-strong bg-[#10130e] shadow-[5px_5px_0_var(--chunk-shadow)]">
          <div class="flex items-center justify-between gap-3 border-b border-[#303725] px-4 py-3 font-mono text-xs text-[#d7dcc4]">
            <span><span class="text-[#b7d073]">$</span> kick</span>
            <span class="text-[#a0aa91]">TUI · Linux</span>
          </div>
          <div class="overflow-x-auto" tabindex="0" role="region" aria-label="Kickoutchi TUI screenshot. Scroll horizontally to see the full terminal on smaller screens.">
            <img src="/previews/kickoutchi-tui.webp" alt="Kickoutchi 1.4.2 showing a selected Node.js process on port 3000, its listening address, process details, and keyboard shortcuts for inspecting or terminating it." width="1320" height="624" class="block w-full min-w-[680px]" loading="lazy" />
          </div>
        </div>
        <figcaption class="mt-4 flex flex-wrap justify-between gap-2 text-sm text-muted">
          <span>Captured from Kickoutchi v1.4.2 with a local demo server.</span>
          <a href="/previews/kickoutchi-tui.webp" target="_blank" rel="noopener noreferrer" class="text-accent underline underline-offset-4">View full size ↗</a>
        </figcaption>
        <p class="mt-2 text-xs text-muted sm:hidden">Swipe the terminal to see the full table.</p>
      </figure>
      <details class="mt-5 rounded-lg border border-border bg-bg">
        <summary class="cursor-pointer px-4 py-3 text-sm font-semibold text-accent">See the confirmation step</summary>
        <p class="px-4 pb-4 text-sm leading-relaxed text-muted">The prompt names the process and every affected port. Nothing stops until you confirm.</p>
        <div class="overflow-x-auto rounded-b-lg bg-[#10130e]" tabindex="0" role="region" aria-label="Termination confirmation screenshot. Scroll horizontally on smaller screens.">
          <img src="/previews/kickoutchi-confirm.webp" alt="The real confirmation dialog identifies the Node.js process, lists its ports 3000, 5173, and 8080, and offers y to confirm or Escape to cancel." width="1320" height="624" class="block w-full min-w-[680px]" loading="lazy" />
        </div>
      </details>
      <div class="mt-8 grid gap-6 border-t border-border pt-6 sm:grid-cols-2">
        <div class="flex gap-3">
          <kbd class="flex size-9 shrink-0 items-center justify-center rounded border border-border-strong bg-bg font-mono text-sm">↵</kbd>
          <p class="text-sm leading-relaxed text-muted"><strong class="block text-fg">Inspect first</strong>Open process details with Enter. Browsing doesn't terminate anything.</p>
        </div>
        <div class="flex gap-3">
          <kbd class="flex size-9 shrink-0 items-center justify-center rounded border border-border-strong bg-bg font-mono text-sm">x</kbd>
          <p class="text-sm leading-relaxed text-muted"><strong class="block text-fg">Review, then confirm</strong>Press x to review the target. Confirm to stop it, or Escape to cancel.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:py-16">
    <p class="pixel-label">Already know the port?</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Get straight to it.</h2>
    <p class="mt-3 max-w-xl leading-relaxed text-muted">Use the CLI for a quick answer, or add JSON output to your scripts.</p>
    <div class="mt-8 grid gap-8 md:grid-cols-3">
      {tasks.map((task) => (
        <article class="flex min-w-0 flex-col border-t-2 border-border-strong pt-5">
          <p class="font-pixel text-lg text-accent">{task.number}</p>
          <h3 class="mt-2 text-xl font-semibold">{task.title}</h3>
          <p class="mt-2 mb-5 text-sm leading-relaxed text-muted">{task.description}</p>
          <div class="mt-auto"><CommandBlock code={task.command} /></div>
          <a href={task.href} class="mt-4 text-sm font-semibold text-accent hover:underline">{task.link} →</a>
        </article>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-12 sm:pb-16">
    <div class="grid items-center gap-8 rounded-xl border-2 border-border-strong bg-surface p-5 sm:p-8 lg:grid-cols-2 lg:gap-12">
      <div>
        <p class="pixel-label">Inspect before you kick</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight">Clear the right process.</h2>
        <p class="mt-4 leading-relaxed text-muted">A stale server can leave a whole process tree behind. Inspect its family before choosing what to stop.</p>
        <ul class="mt-5 space-y-3 text-sm leading-relaxed text-muted">
          <li class="flex gap-3"><span class="text-accent" aria-hidden="true">✓</span>One process by default. Tree cleanup only when you ask.</li>
          <li class="flex gap-3"><span class="text-accent" aria-hidden="true">✓</span>Targets are checked again before termination.</li>
          <li class="flex gap-3"><span class="text-accent" aria-hidden="true">✓</span>Changed or uncertain targets are refused.</li>
        </ul>
        <a href="/docs/safety" class="mt-6 inline-block text-sm font-semibold text-accent underline underline-offset-4">How the safety checks work →</a>
      </div>
      <div class="min-w-0"><Terminal title="kick · read-only inspection" lines={demo} animate /></div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-4">
    <div class="install-finish relative overflow-hidden rounded-xl border-2 border-border-strong bg-accent px-5 py-10 text-accent-fg sm:px-10 sm:py-12">
      <div class="relative z-10 grid items-center gap-8 md:grid-cols-[1fr_auto]">
        <div>
          <p class="font-pixel text-4xl leading-none sm:text-5xl">CLEAR THE SWAMP.</p>
          <p class="mt-4 max-w-lg leading-relaxed text-accent-fg/85">Your next dev server deserves a free port.</p>
          <p class="mt-3 max-w-lg text-sm leading-relaxed text-accent-fg/85">Prefer a package manager? Homebrew, Scoop, AUR, Cargo, and Nix are available too.</p>
        </div>
        <div class="flex flex-wrap items-center gap-4 md:flex-col">
          <ButtonLink href="/install" variant="secondary">Choose your install method →</ButtonLink>
          <a href={LINKS.github} target="_blank" rel="noopener noreferrer" class="text-sm font-semibold underline underline-offset-4">View the source ↗</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
