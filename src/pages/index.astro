---
import Layout from "../layouts/Layout.astro";
import ButtonLink from "../components/ButtonLink.astro";
import Terminal from "../components/Terminal.astro";
import type { TerminalLine } from "../components/Terminal.astro";
import ModeCard from "../components/ModeCard.astro";
import FeatureCard from "../components/FeatureCard.astro";
import PocketDevice from "../components/PocketDevice.astro";
import { FEATURES } from "../data/features";
import { PLATFORM_SUPPORT, PACKAGE_STATUS } from "../data/package-status";
import { LINKS, RELEASE_ASSETS, SITE } from "../data/links";

const demo: TerminalLine[] = [
  { kind: "command", text: "kick inspect --port 3000" },
  { kind: "output", text: "Target: PID 18422 (node)" },
  { kind: "output", text: "  Ports: TCP 127.0.0.1:3000" },
  { kind: "output", text: "Ancestors (nearest first):" },
  { kind: "output", text: "  PID 18190 (pnpm); pnpm dev" },
  { kind: "output", text: "Tree (3 processes):" },
  { kind: "output", text: "  PID 18422 (node) [TCP 127.0.0.1:3000]" },
  { kind: "output", text: "    PID 18431 (vite)" },
  { kind: "output", text: "    PID 18444 (esbuild)" },
  { kind: "muted", text: "To terminate this tree: kick kill --pid 18422 --tree" },
  { kind: "output", text: "" },
  { kind: "command", text: "kick kill --pid 18422 --tree" },
  { kind: "output", text: "Scope: tree (3 processes)" },
  { kind: "muted", text: "Type tree to terminate all 3 processes, or press Enter to cancel: tree" },
  { kind: "success", text: "sent SIGTERM to 3 process(es) in the tree rooted at PID 18422 (node)" },
  { kind: "success", text: "confirmed target ports are no longer visible" },
];

const safety = [
  "Every interactive termination is confirmed, then checked against a fresh process snapshot.",
  "PID 0, PID 1, Kickoutchi's own PID, and Windows PID 4 are blocked outright.",
  "kill --port refuses ambiguous ports instead of guessing which PID to hit.",
  "Protected processes, including Docker owners, require typing the PID or process name to confirm.",
  "Tree scope is opt-in, typed, and bounded; group scope stays Linux/macOS-only.",
];

const homepageFeatureIds = new Set([
  "see-ports",
  "ask-why",
  "watch-changes",
  "inspect-first",
  "cross-platform",
  "scriptable",
]);
const homepageFeatures = FEATURES.filter((feature) => homepageFeatureIds.has(feature.id));
const availablePackages = PACKAGE_STATUS.filter((pkg) => pkg.status === "available");
---

<Layout>
  <section class="relative mx-auto max-w-6xl px-4 pt-14 pb-16 sm:pt-20">
    <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
      <div class="text-center lg:text-left">
        <p class="pixel-label inline-flex items-center gap-2">
          <span class="inline-block size-2 bg-kick" aria-hidden="true"></span>
          Port janitor · v{SITE.version}
        </p>
        <h1 class="mt-4 text-[2.7rem] leading-[1.02] font-bold tracking-tight sm:text-6xl">
          Your ports have squatters,
          <span class="mt-3 block font-pixel font-medium tracking-tight text-kick">
            so kick them out.
          </span>
        </h1>
        <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-muted lg:mx-0">
          Find the process behind a local port, inspect its family, and clear stale dev servers from
          the TUI or a script.
        </p>
        <p class="mx-auto mt-4 max-w-xl text-sm leading-relaxed text-fg lg:mx-0">
          Kickoutchi resolves the target again before sending a signal, and nothing dies until you
          choose a scope.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3 lg:justify-start">
          <ButtonLink href="/install">Install Kickoutchi</ButtonLink>
          <ButtonLink href="/docs" variant="secondary">Read the docs</ButtonLink>
          <ButtonLink href={LINKS.github} variant="ghost" external>GitHub ↗</ButtonLink>
        </div>
        <p class="mt-6 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-sm text-muted lg:justify-start">
          <span>Linux · macOS · Windows</span>
          <span class="text-border-strong" aria-hidden="true">▮</span>
          <span>
            binaries <code class="font-mono text-[0.9em] text-fg">kickoutchi</code>{" "}and{" "}
            <code class="font-mono text-[0.9em] text-fg">kick</code>
          </span>
          <span class="text-border-strong" aria-hidden="true">▮</span>
          <span>MIT</span>
        </p>
      </div>
      <PocketDevice />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
    <p class="pixel-label">See it first</p>
    <div class="mt-5 grid items-start gap-10 lg:grid-cols-[0.8fr_1.2fr]">
      <div>
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
          Know the process before you touch it.
        </h2>
        <p class="mt-4 leading-relaxed text-muted">
          A stale dev server is rarely one process. <code class="font-mono text-sm text-fg">kick inspect</code>{" "}
          shows its parents, children, ports, and the exact cleanup command for the scope you choose.
        </p>
        <ol class="mt-7 space-y-4">
          {
            [
              ["1", "Inspect a PID or port in read-only mode."],
              ["2", "Choose one process, its tree, or a Unix process group."],
              ["3", "Type the scope to confirm, then verify the port is free."],
            ].map(([step, text]) => (
              <li class="flex gap-3 text-sm leading-relaxed text-muted">
                <span class="font-bold text-accent">{step}.</span>
                <span>{text}</span>
              </li>
            ))
          }
        </ol>
      </div>
      <Terminal title="kick • inspect, confirm, verify" lines={demo} animate />
    </div>

    <div class="mt-12 grid gap-6 border-y-2 border-border-strong/25 py-8 md:grid-cols-[0.7fr_1.3fr] md:items-center">
      <div>
        <p class="text-base font-semibold text-accent">When the OS answer is vague</p>
        <code class="mt-2 block font-mono text-xl font-bold text-fg">$ kick why 3000</code>
      </div>
      <div>
        <h3 class="text-xl font-semibold">"Address already in use" is not an explanation.</h3>
        <p class="mt-2 leading-relaxed text-muted">
          <code class="font-mono text-sm text-fg">kick why</code> checks a process snapshot, tries a
          short-lived bind, and reports evidence and certainty so an unknown owner never becomes a
          guessed PID.
        </p>
        <a href="/docs/watch-and-why" class="mt-3 inline-flex text-sm font-semibold text-accent hover:underline">
          Read about Watch &amp; Why →
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:py-16">
    <p class="pixel-label">Guardrails</p>
    <div class="pocket-panel relative mt-5 overflow-hidden">
      <div
        class="h-2.5 w-full border-b-2 border-border-strong bg-[repeating-linear-gradient(-45deg,var(--warning)_0_10px,transparent_10px_20px)]"
        aria-hidden="true"
      ></div>
      <div class="grid gap-8 p-6 sm:p-10 lg:grid-cols-[0.8fr_1.2fr]">
        <div>
          <span class="inline-flex size-11 items-center justify-center rounded-md bg-accent/10 text-accent">
            <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <path d="M9 12l2 2 4-4"></path>
            </svg>
          </span>
          <h2 class="mt-4 text-3xl font-bold tracking-tight">Safe by default</h2>
          <p class="mt-3 leading-relaxed text-muted">
            Termination starts with a process identity rather than only a port number, so changed
            or uncertain targets are refused.
          </p>
          <ButtonLink href="/docs/safety" variant="secondary" size="sm" class="mt-5">
            Read the safety model
          </ButtonLink>
        </div>
        <ol class="grid gap-x-8 gap-y-4 self-center sm:grid-cols-2">
          {
            safety.map((item, i) => (
              <li class="flex gap-3 text-sm leading-relaxed">
                <span class="shrink-0 font-bold text-accent">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span class="text-muted">{item}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:py-16">
    <p class="pixel-label">Pick an interface</p>
    <h2 class="mt-5 max-w-2xl text-3xl font-bold tracking-tight sm:text-4xl">
      Use the TUI to browse and the CLI to automate.
    </h2>
    <p class="mt-3 max-w-2xl leading-relaxed text-muted">
      Both interfaces use the same native collectors, labels, filters, and target checks.
    </p>
    <div class="mt-8 grid gap-8 md:grid-cols-2">
      <ModeCard
        icon="tui"
        eyebrow="Interactive"
        title="Guided TUI"
        description="Browse a live port table, inspect process details, and confirm one-process or tree cleanup."
        command="kickoutchi"
        href="/docs/tui"
        ctaLabel="Explore the TUI"
      />
      <ModeCard
        icon="cli"
        eyebrow="Headless"
        title="Scriptable CLI"
        description="List ports, explain failed binds, watch changes, inspect process families, and terminate an explicit scope."
        command="kick list --filter 'label:web family:ipv4'"
        href="/docs/cli"
        ctaLabel="Explore the CLI"
      />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:py-16">
    <p class="pixel-label">What it handles</p>
    <div class="mt-5 grid gap-8 lg:grid-cols-[0.65fr_1.35fr]">
      <div>
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
          One native snapshot drives every command.
        </h2>
        <p class="mt-4 leading-relaxed text-muted">
          Kickoutchi reads each operating system directly and uses the same snapshot for the table,
          process details, filters, JSON, watch events, and bind diagnostics.
        </p>
        <ButtonLink href="/docs" variant="ghost" size="sm" class="mt-5">
          Browse the full reference →
        </ButtonLink>
      </div>
      <div class="grid gap-x-8 sm:grid-cols-2">
        {homepageFeatures.map((feature) => <FeatureCard feature={feature} />)}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:py-16">
    <p class="pixel-label">Get it</p>
    <div class="pocket-panel mt-5 grid gap-10 p-6 sm:p-8 lg:grid-cols-[1.1fr_0.9fr]">
      <div>
        <h2 class="text-3xl font-bold tracking-tight">Install in one line</h2>
        <p class="mt-3 leading-relaxed text-muted">
          Use the installer below, a package manager, or a release archive, with checksums and every
          supported method documented on the install page.
        </p>
        <div class="mt-5">
          <Terminal
            title="Linux & macOS"
            lines={[
              { kind: "command", text: "curl --proto '=https' --tlsv1.2 -LsSf \\" },
              { kind: "command", text: "  " + RELEASE_ASSETS.installerSh + " \\", prompt: " " },
              { kind: "command", text: "  | sh", prompt: " " },
            ]}
          />
        </div>
        <ButtonLink href="/install" class="mt-6">See install and verification options</ButtonLink>
      </div>

      <div>
        <h3 class="text-xl font-semibold">Platforms</h3>
        <dl class="mt-3">
          {
            PLATFORM_SUPPORT.map((platform) => (
              <div class="border-t-2 border-border-strong/20 py-4 first:border-t-0 first:pt-0">
                <dt class="font-semibold text-fg">{platform.platform}</dt>
                <dd class="mt-1 text-sm leading-relaxed text-muted">{platform.detail}</dd>
              </div>
            ))
          }
        </dl>
        <div class="border-t-2 border-border-strong/20 pt-5">
          <h3 class="font-semibold">Available packages</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            {availablePackages.map((pkg) => pkg.name).join(", ")}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-16 pb-4">
    <div class="flex flex-col items-center gap-6 text-center">
      <p class="font-pixel text-[clamp(2.2rem,6.5vw,4.5rem)] leading-[0.95] tracking-tight">
        CLEAR THE <span class="text-accent">SWAMP.</span>
      </p>
      <p class="max-w-xl text-muted">
        Start with the TUI, or run <code class="font-mono text-sm text-fg">kick list</code> for a
        one-shot table.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <ButtonLink href="/install">Install Kickoutchi</ButtonLink>
        <ButtonLink href={LINKS.github} variant="secondary" external>View the source</ButtonLink>
      </div>
    </div>
  </section>
</Layout>
