---
import Layout from "../layouts/Layout.astro";
import CopyButton from "../components/CopyButton.astro";
import SquatterScene from "../components/SquatterScene.astro";
import { INSTALL_METHODS } from "../data/install-methods";
import { PLATFORM_SUPPORT } from "../data/package-status";
import { LINKS, SITE } from "../data/links";

/*
  Three type sizes only: text-sm (commands, notes), text-lg (reading),
  text-display (headlines). Three families: pixel for headlines, grotesk for
  reading, mono for anything you can type. The page is plain black: no
  filled panels, no shadows. Kick orange is spent on the boot and the two
  buttons that act.
*/

const method = (id: string) => INSTALL_METHODS.find((m) => m.id === id)!;
const unix = method("installer-unix");
const windows = method("installer-windows");

type Line = { kind: "cmd" | "out" | "dim" | "ok"; text: string };
const cmd = (text: string): Line => ({ kind: "cmd", text });
const out = (text: string): Line => ({ kind: "out", text });
const dim = (text: string): Line => ({ kind: "dim", text });
const ok = (text: string): Line => ({ kind: "ok", text });

const COMMANDS: { id: string; title: string; body: string; href: string; link: string; lines: Line[] }[] = [
  {
    id: "list",
    title: "Find the owner",
    body: "Port 3000 is busy. See the process behind it before you decide anything. Add --json for scripts.",
    href: "/docs/cli",
    link: "List and filter ports",
    lines: [
      cmd("kick list --port 3000"),
      out("PROTO  ADDRESS    PORT  PID    PROCESS  STATE"),
      out("TCP    127.0.0.1  3000  18422  node     LISTEN"),
    ],
  },
  {
    id: "inspect",
    title: "Read the family",
    body: "Dev servers leave workers behind. Inspect shows the tree, the group, and the exact command to clear it. Read-only.",
    href: "/docs/scoped-kills",
    link: "Inspect and scoped kills",
    lines: [
      cmd("kick inspect --port 3000"),
      out("Target: PID 18422 (node)"),
      out("  Command: node server.mjs"),
      out("  Ports: TCP 127.0.0.1:3000"),
      dim("  … ancestors and siblings"),
      out("Tree (3 processes):"),
      out("  PID 18422 (node) [TCP 127.0.0.1:3000]"),
      out("    PID 18431 (vite)"),
      out("    PID 18444 (esbuild)"),
      ok("To terminate this tree: kick kill --pid 18422 --tree"),
    ],
  },
  {
    id: "why",
    title: "Explain the conflict",
    body: "Got \"address already in use\"? Why probes the bind and returns the evidence, even when the owner is unclear.",
    href: "/docs/watch-and-why",
    link: "Understand bind failures",
    lines: [
      cmd("kick why 3000"),
      out("TCP 127.0.0.1:3000  in use by PID 18422 (node)"),
      ok("TCP [::1]:3000      free"),
      dim("add --verbose for every probe, evidence item, and gap"),
    ],
  },
  {
    id: "watch",
    title: "Watch it change",
    body: "One line per change as servers bind, release, or get replaced. Pipe it anywhere.",
    href: "/docs/watch-and-why",
    link: "Watch ports live",
    lines: [
      cmd("kick watch --port 5173"),
      out("BIND TCP 127.0.0.1:5173 listen owners=21077 filter=matched certainty=proven"),
      out("RELEASE TCP 127.0.0.1:5173 listen owners=21077 filter=matched certainty=proven"),
      dim("  … observed timestamps trimmed"),
    ],
  },
  {
    id: "kill",
    title: "Kick it out",
    body: "One process or a whole batch, confirmed by you, checked again right before the signal, then checked for a real exit.",
    href: "/docs/safety",
    link: "How confirmation works",
    lines: [
      cmd("kick kill --pid 18422"),
      out("Terminate PID 18422 (node)"),
      out("Scope: process"),
      out("Ports: TCP 127.0.0.1:3000"),
      out("Command: kill 18422"),
      out("Type y to confirm, or press Enter to cancel: y"),
      ok("sent SIGTERM to PID 18422 (node)"),
      ok("PID 18422 (node) exited"),
      ok("confirmed target ports are no longer visible"),
    ],
  },
];

const KEYS = [
  { key: "↵", label: "Details" },
  { key: "x", label: "Terminate" },
  { key: "X", label: "Force kill" },
  { key: "t", label: "Kill tree" },
  { key: "/", label: "Search" },
  { key: "m", label: "Full report" },
  { key: "?", label: "Help" },
  { key: "q", label: "Quit" },
];

const PIPELINE = [
  { title: "Find", body: "One snapshot ties every socket to its owner." },
  { title: "Inspect", body: "Read the tree and group. Nothing is stopped." },
  { title: "Confirm", body: "Type y, tree, force, or a protected PID." },
  { title: "Re-check", body: "Identity, ports, and protection are read again." },
  { title: "Signal", body: "SIGTERM by default. Any drift and it refuses." },
];

const CHANNELS = [
  { name: "Homebrew", where: "macOS, Linux", code: method("homebrew").commands[0].code },
  { name: "Scoop", where: "Windows", code: method("scoop").commands.map((c) => c.code).join("\n") },
  { name: "AUR", where: "Arch", code: method("aur-bin").commands[0].code },
  { name: "Nix", where: "Linux", code: method("nix").commands[0].code },
  { name: "Cargo", where: "Anywhere Rust runs", code: method("cargo").commands[0].code },
];
---

<Layout>
  <div class="landing">
    <!-- Hero: the pitch, the install line, and a port with a squatter on it -->
    <section class="hero">
      <div class="wrap">
        <div class="split hero-top">
          <h1 class="headline font-pixel text-display">Your ports have squatters. Kick them out.</h1>

          <div class="min-w-0">
            <p class="text-lg text-muted">
              Kickoutchi is a TUI and CLI port janitor. See which process owns a local port, read
              its family, and clear the stale dev server without guessing.
            </p>

            <div id="quick-install" class="quick-install mt-6 scroll-mt-24">
              <fieldset class="platforms">
                <legend class="sr-only">Install for your platform</legend>
                <input class="sr-only" type="radio" name="install-platform" id="install-unix" value="unix" checked />
                <label for="install-unix" class="text-sm">Linux &amp; macOS</label>
                <input class="sr-only" type="radio" name="install-platform" id="install-windows" value="windows" />
                <label for="install-windows" class="text-sm">Windows</label>
              </fieldset>
              <div class="install-cmd unix-command">
                <pre class="font-mono text-sm"><code>{unix.commands[0].code}</code></pre>
                <CopyButton text={unix.commands[0].code} class="shrink-0 bg-transparent!" />
              </div>
              <div class="install-cmd windows-command">
                <pre class="font-mono text-sm"><code>{windows.commands[0].code}</code></pre>
                <CopyButton text={windows.commands[0].code} class="shrink-0 bg-transparent!" />
              </div>
              <p class="mt-3 text-sm text-muted">
                Then run <code class="font-mono text-fg">kick</code>. Or use{" "}
                <a href="/install" class="ink-link">Homebrew, Scoop, AUR, Nix, or Cargo</a>.
              </p>
            </div>
          </div>
        </div>

        <div class="hero-scene">
          <SquatterScene />
        </div>
      </div>
      <div class="ground" aria-hidden="true"></div>
    </section>

    <!-- The real TUI -->
    <section id="see-it" class="wrap band scroll-mt-20">
      <div class="split">
        <h2 class="headline font-pixel text-display">Meet your port janitor.</h2>
        <p class="text-lg text-muted">
          Run <code class="font-mono text-fg">kick</code> with no arguments. Every open port, its
          owner, and the details of whatever you select. Browsing never stops anything.
        </p>
      </div>

      <figure class="mt-12">
        <div class="screen overflow-x-auto" tabindex="0" role="region" aria-label="Kickoutchi TUI screenshot. Scroll horizontally to see the full terminal on smaller screens.">
          <img src="/previews/kickoutchi-tui.webp" alt="Kickoutchi showing a selected Node.js process on port 3000, its listening address, process details, and keyboard shortcuts for inspecting or terminating it." width="1320" height="624" class="block w-full min-w-[680px]" loading="lazy" />
        </div>
        <figcaption class="mt-3 flex flex-wrap justify-between gap-2 text-sm text-faint">
          <span>Captured from a real session with a local demo server.</span>
          <a href="/previews/kickoutchi-tui.webp" target="_blank" rel="noopener noreferrer" class="ink-link">View full size</a>
        </figcaption>
      </figure>

      <ul class="keys mt-10" aria-label="Main TUI keys">
        {KEYS.map((k) => (
          <li class="key-item">
            <kbd class="key font-mono text-lg">{k.key}</kbd>
            <span class="text-sm text-muted">{k.label}</span>
          </li>
        ))}
      </ul>

      <details class="confirm-peek mt-8">
        <summary class="text-sm">See the confirmation step</summary>
        <p class="mt-3 max-w-2xl text-sm text-muted">
          The prompt names the process and every affected port. Warnings wrap in full, and nothing
          stops until you confirm.
        </p>
        <div class="screen mt-4 overflow-x-auto" tabindex="0" role="region" aria-label="Termination confirmation screenshot. Scroll horizontally on smaller screens.">
          <img src="/previews/kickoutchi-confirm.webp" alt="The confirmation dialog identifies the Node.js process, lists its ports 3000, 5173, and 8080, and offers y to confirm or Escape to cancel." width="1320" height="624" class="block w-full min-w-[680px]" loading="lazy" />
        </div>
      </details>
    </section>

    <!-- The CLI: five verbs, one transcript at a time -->
    <section class="wrap band">
      <div class="split">
        <h2 class="headline font-pixel text-display">Get straight to it.</h2>
        <p class="text-lg text-muted">
          Already know the port? Five verbs cover the job. Every transcript below uses the real
          output format.
        </p>
      </div>

      <div class="verbs mt-12">
        <fieldset class="verb-list">
          <legend class="sr-only">Command</legend>
          {COMMANDS.map((c, i) => (
            <>
              <input class="sr-only" type="radio" name="verb" id={`verb-${c.id}`} checked={i === 0} />
              <label for={`verb-${c.id}`} class="verb">
                <span class="verb-cmd font-mono text-lg">kick {c.id}</span>
                <span class="verb-title text-sm">{c.title}</span>
              </label>
            </>
          ))}
        </fieldset>

        {COMMANDS.map((c) => (
          <div class="verb-panel" data-panel={c.id}>
            <p class="max-w-xl text-lg text-muted">{c.body}</p>
            <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
              <a href={c.href} class="ink-link">{c.link}</a>
              <CopyButton text={c.lines[0].text} class="bg-transparent!" />
            </div>
            <pre class="transcript mt-8 font-mono text-sm"><code>{c.lines.map((line) => (
              <span class:list={["line", `is-${line.kind}`]}>{line.kind === "cmd" && <span class="prompt">$ </span>}{line.text}</span>
            ))}</code></pre>
          </div>
        ))}
      </div>
    </section>

    <!-- Safety: the path every kick walks -->
    <section class="wrap band">
      <div class="split">
        <h2 class="headline font-pixel text-display">Clear the right process.</h2>
        <p class="text-lg text-muted">
          A PID can be reused and a port can change hands between two keystrokes. Every kick walks
          the same path, and it stops the moment the target is no longer the one you confirmed.
        </p>
      </div>

      <div class="split mt-12 safety">
        <ol class="path">
          {PIPELINE.map((step, i) => (
            <li class="step">
              <span class="step-n font-mono text-sm" aria-hidden="true">{i + 1}</span>
              <h3 class="step-title font-pixel text-lg">{step.title}</h3>
              <p class="step-body text-lg text-muted">{step.body}</p>
            </li>
          ))}
        </ol>

        <div class="min-w-0">
          <ul class="facts">
            <li class="text-lg">One process by default. Trees and groups only when you ask.</li>
            <li class="text-lg">Protected processes need the PID or name typed. <code class="font-mono text-sm">--yes</code> can't skip it.</li>
            <li class="text-lg">Changed or uncertain targets are refused, never guessed.</li>
          </ul>
          <a href="/docs/safety" class="ink-link mt-6 inline-block text-sm">Read how the safety checks work</a>
        </div>
      </div>
    </section>

    <!-- Platforms and channels -->
    <section class="wrap band">
      <div class="split">
        <h2 class="headline font-pixel text-display">Runs in every swamp.</h2>
        <p class="text-lg text-muted">
          Native collection on Linux, macOS, and Windows. No daemon to run. Two binaries ship
          together: <code class="font-mono text-fg">kickoutchi</code> and the short <code class="font-mono text-fg">kick</code>.
        </p>
      </div>

      <dl class="platform-list mt-12">
        {PLATFORM_SUPPORT.map((p) => (
          <div>
            <dt class="font-pixel text-lg">{p.platform}</dt>
            <dd class="mt-1 text-sm text-muted">{p.detail}</dd>
          </div>
        ))}
      </dl>

      <ul class="channels mt-12">
        {CHANNELS.map((c) => (
          <li class="channel">
            <p class="channel-head">
              <span class="text-lg font-bold">{c.name}</span>
              <span class="text-sm text-faint">{c.where}</span>
            </p>
            <pre class="font-mono text-sm"><code>{c.code}</code></pre>
            <CopyButton text={c.code} class="shrink-0 justify-self-start bg-transparent!" />
          </li>
        ))}
      </ul>
      <a href="/install" class="ink-link mt-6 inline-block text-sm">Every install method, with checksums and updates</a>
    </section>

    <!-- Send-off -->
    <section class="wrap band">
      <div class="split finale">
        <h2 class="headline font-pixel text-display">Clear the swamp.</h2>
        <div class="min-w-0">
          <p class="text-lg text-muted">Your next dev server deserves a free port. Free and open source under MIT.</p>
          <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-4">
            <a href="/install" class="btn-kick font-pixel text-lg">Install Kickoutchi</a>
            <a href="/docs" class="ink-link text-lg">Read the docs</a>
            <a href={LINKS.github} target="_blank" rel="noopener noreferrer" class="ink-link text-lg">Source on GitHub</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  /* ---- Page frame ---- */
  .wrap {
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: 1rem;
  }
  .band {
    padding-top: clamp(6rem, 12vw, 10rem);
  }
  /* One two-column rhythm for the whole page: wide left, narrow right. */
  .split {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 1024px) {
    .split {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      align-items: end;
      column-gap: 3rem;
    }
  }
  .headline {
    max-width: 24ch;
    margin: 0;
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.01em;
  }

  .ink-link {
    color: var(--accent);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .ink-link:hover {
    color: var(--fg);
  }

  /* ---- Hero ---- */
  .hero {
    overflow-x: clip;
    padding-top: clamp(2.5rem, 5vw, 4rem);
  }
  .hero-top {
    align-items: start;
  }
  .hero-scene {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  /* The ground the digits stand on: a row of pixels across the whole page. */
  .ground {
    height: 4px;
    background: repeating-linear-gradient(90deg, var(--border-strong) 0 8px, transparent 8px 16px);
  }

  .platforms {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .platforms label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    color: var(--muted);
    font-weight: 600;
    cursor: pointer;
  }
  .platforms label::before {
    content: "";
    width: 0.5rem;
    height: 0.5rem;
    border: 2px solid var(--faint);
  }
  .platforms label:hover {
    color: var(--fg);
  }
  .platforms input:checked + label {
    color: var(--fg);
  }
  .platforms input:checked + label::before {
    border-color: var(--accent);
    background: var(--accent);
  }
  .platforms input:focus-visible + label {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }
  .quick-install:has(#install-unix:checked) .windows-command,
  .quick-install:has(#install-windows:checked) .unix-command {
    display: none;
  }
  .install-cmd {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.85rem 0.85rem 0.85rem 1rem;
    border: 2px solid var(--border-strong);
  }
  .install-cmd pre {
    flex: 1;
    min-width: 0;
    margin: 0;
    line-height: 1.6;
    white-space: pre-wrap;
    word-break: break-all;
  }
  .install-cmd code::before {
    content: "$ ";
    color: var(--term-accent);
  }

  /* ---- Screens ---- */
  .screen {
    border: 2px solid var(--border-strong);
  }
  .keys {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 640px) {
    .keys {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .keys {
      grid-template-columns: repeat(8, minmax(0, 1fr));
    }
  }
  .key-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .key {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 2px solid var(--fg);
    color: var(--fg);
    font-weight: 700;
  }
  .confirm-peek summary {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    cursor: pointer;
    color: var(--accent);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  /* ---- Verbs ---- */
  .verbs {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 1024px) {
    .verbs {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
      column-gap: 3rem;
    }
  }
  .verb-list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    border: 0;
    border-top: 2px solid var(--border-strong);
  }
  .verb {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0 1rem;
    padding: 0.9rem 0 0.9rem 1.5rem;
    border-bottom: 2px solid var(--border-strong);
    color: var(--faint);
    cursor: pointer;
    position: relative;
  }
  .verb::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 0.5rem;
    height: 0.5rem;
    translate: 0 -50%;
    background: var(--kick);
    visibility: hidden;
  }
  .verb-cmd {
    color: var(--muted);
    font-weight: 600;
  }
  .verb:hover .verb-cmd {
    color: var(--fg);
  }
  .verb-list input:checked + .verb {
    color: var(--muted);
  }
  .verb-list input:checked + .verb::before {
    visibility: visible;
  }
  .verb-list input:checked + .verb .verb-cmd {
    color: var(--fg);
  }
  .verb-list input:focus-visible + .verb {
    outline: 2px solid var(--ring);
    outline-offset: -2px;
  }
  .verb-panel {
    display: none;
    min-width: 0;
    padding-top: 0.9rem;
  }
  .verbs:has(#verb-list:checked) [data-panel="list"],
  .verbs:has(#verb-inspect:checked) [data-panel="inspect"],
  .verbs:has(#verb-why:checked) [data-panel="why"],
  .verbs:has(#verb-watch:checked) [data-panel="watch"],
  .verbs:has(#verb-kill:checked) [data-panel="kill"] {
    display: block;
  }
  .transcript {
    margin-bottom: 0;
    line-height: 1.7;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  /* On narrow screens a wrapped table row is unreadable, so scroll it. */
  @media (max-width: 1023px) {
    .transcript {
      white-space: pre;
      overflow-x: auto;
    }
  }
  @media (min-width: 1024px) {
    /* Tall enough for the longest transcript, so switching verbs never
       moves the text underneath. */
    .transcript {
      min-height: calc(10 * 1.7em);
    }
  }
  .transcript .line {
    display: block;
  }
  .transcript .prompt {
    color: var(--term-accent);
  }
  .transcript .is-cmd {
    color: var(--fg);
    font-weight: 600;
  }
  .transcript .is-out {
    color: var(--term-out);
  }
  .transcript .is-dim {
    color: var(--term-dim);
  }
  .transcript .is-ok {
    color: var(--accent);
  }

  /* ---- Safety ---- */
  .safety {
    align-items: start;
  }
  .path {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--border-strong);
  }
  .step {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    gap: 0.15rem 0.75rem;
    align-items: baseline;
    padding: 0.9rem 0;
    border-bottom: 2px solid var(--border-strong);
  }
  .step-n {
    color: var(--faint);
  }
  .step-title {
    margin: 0;
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .step-body {
    grid-column: 2;
    margin: 0;
  }
  @media (min-width: 640px) {
    .step {
      grid-template-columns: 1.5rem 7rem minmax(0, 1fr);
    }
    .step-body {
      grid-column: 3;
    }
  }
  .step:last-child .step-title {
    color: var(--kick);
  }
  .facts {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0.9rem 0 0;
    list-style: none;
  }
  .facts li {
    position: relative;
    padding-left: 1.5rem;
  }
  .facts li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 0.5rem;
    height: 0.5rem;
    background: var(--accent);
  }

  /* ---- Platforms and channels ---- */
  .platform-list {
    display: grid;
    gap: 1.5rem 3rem;
    margin-bottom: 0;
  }
  @media (min-width: 768px) {
    .platform-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .channels {
    display: grid;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--border-strong);
  }
  .channel {
    display: grid;
    gap: 0.5rem;
    padding: 0.9rem 0;
