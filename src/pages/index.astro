---
import Layout from "../layouts/Layout.astro";
import ButtonLink from "../components/ButtonLink.astro";
import Terminal from "../components/Terminal.astro";
import type { TerminalLine } from "../components/Terminal.astro";
import ModeCard from "../components/ModeCard.astro";
import FeatureCard from "../components/FeatureCard.astro";
import StatusBadge from "../components/StatusBadge.astro";
import LogoMark from "../components/LogoMark.astro";
import { FEATURES } from "../data/features";
import { PLATFORM_SUPPORT, PACKAGE_STATUS } from "../data/package-status";
import { LINKS, RELEASE_ASSETS } from "../data/links";

// A faithful scoped-kill session: inspect the family, then use explicit tree scope.
const demo: TerminalLine[] = [
  { kind: "command", text: "kick inspect --port 3000" },
  { kind: "output", text: "Target: PID 18422 (node)" },
  { kind: "output", text: "  Ports: TCP 127.0.0.1:3000" },
  { kind: "output", text: "  Process group: 18400" },
  { kind: "output", text: "Ancestors (nearest first):" },
  { kind: "output", text: "  PID 18190 (pnpm) — pnpm dev" },
  { kind: "output", text: "Tree (3 processes):" },
  { kind: "output", text: "  PID 18422 (node) [TCP 127.0.0.1:3000]" },
  { kind: "output", text: "    PID 18431 (vite)" },
  { kind: "output", text: "    PID 18444 (esbuild)" },
  { kind: "output", text: "Process group 18400 (3 members, 0 outside the tree):" },
  { kind: "output", text: "  PID 18422 (node)" },
  { kind: "output", text: "  PID 18431 (vite)" },
  { kind: "output", text: "  PID 18444 (esbuild)" },
  { kind: "muted", text: "To terminate this tree: kick kill --pid 18422 --tree" },
  { kind: "muted", text: "(different root? rerun inspect on an ancestor PID first)" },
  { kind: "output", text: "" },
  { kind: "command", text: "kick kill --pid 18422 --tree" },
  { kind: "output", text: "Terminate process tree from PID 18422 (node)" },
  { kind: "output", text: "Scope: tree (3 processes)" },
  { kind: "output", text: "Ports: TCP 127.0.0.1:3000" },
  { kind: "output", text: "Command: kick kill --pid 18422 --tree" },
  { kind: "output", text: "  PID 18422 (node)" },
  { kind: "output", text: "    PID 18431 (vite)" },
  { kind: "output", text: "    PID 18444 (esbuild)" },
  { kind: "muted", text: "Type tree to terminate all 3 processes, or press Enter to cancel: tree" },
  { kind: "success", text: "sent SIGTERM to 3 process(es) in the tree rooted at PID 18422 (node)" },
  { kind: "success", text: "confirmed target ports are no longer visible" },
];

const safety = [
  "Every termination is confirmed • and --yes still prints the banner, warnings, and fresh-scan refusals.",
  "PID 0, PID 1, Kickoutchi's own PID, and Windows PID 4 are blocked outright.",
  "kill --port refuses ambiguous ports instead of guessing which PID to hit.",
  "Protected processes require typing the PID or process name to confirm.",
  "Tree scope is opt-in, typed, and bounded; group scope stays Linux/macOS-only.",
  "Unix scoped kills freeze first; Windows tree kill uses Job Object containment.",
];

const availablePackages = PACKAGE_STATUS.filter((pkg) => pkg.status === "available");
const pendingPackages = PACKAGE_STATUS.filter((pkg) => pkg.status !== "available");
---

<Layout>
  <!-- Hero -->
  <section class="mx-auto max-w-6xl px-4 pt-14 pb-10 sm:pt-20">
    <div class="grid items-center gap-10 lg:grid-cols-[1.05fr_0.95fr]">
      <div class="text-center lg:text-left">
        <p class="font-pixel text-sm uppercase tracking-[0.2em] text-accent">
          Kickoutchi • port janitor
        </p>
        <h1 class="mt-3 text-4xl font-bold leading-tight tracking-tight sm:text-5xl">
          Kick stale dev servers out of your local ports.
        </h1>
        <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-muted lg:mx-0">
          Kickoutchi shows which process owns each open TCP/UDP port, lets you inspect the family
          around it, then terminates stale port-owning processes safely • from a guided TUI or a script-friendly CLI.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3 lg:justify-start">
          <ButtonLink href="/install">Install Kickoutchi</ButtonLink>
          <ButtonLink href="/docs" variant="secondary">Read the docs</ButtonLink>
          <ButtonLink href={LINKS.github} variant="ghost" external>View on GitHub</ButtonLink>
        </div>
        <p class="mt-6 flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-sm text-muted lg:justify-start">
          <span>Scoped tree kill on Linux, macOS, and Windows CLI. Group scope stays Unix-only.</span>
          <span aria-hidden="true">•</span>
          <span>Two binaries: <code class="font-mono text-fg">kickoutchi</code> and <code class="font-mono text-fg">kick</code>.</span>
        </p>
      </div>

      <div class="relative mx-auto w-full max-w-md lg:max-w-none">
        <LogoMark
          alt="The Kickoutchi mascot: a pixel-art pocket device with a boot icon kicking out a port mascot."
          class="relative mx-auto w-full max-w-[17rem] sm:max-w-[22rem]"
          priority
        />
      </div>
    </div>
  </section>

  <!-- Terminal demo -->
  <section class="mx-auto max-w-3xl px-4 py-12">
    <div class="mb-5 text-center">
      <h2 class="text-2xl font-bold tracking-tight">Inspect first, then choose the scope</h2>
      <p class="mt-2 text-muted">See the parent, tree, and process group before you kick more than one PID.</p>
    </div>
    <Terminal title="kick • clearing a dev-server tree" lines={demo} />
  </section>

  <!-- TUI vs CLI -->
  <section class="mx-auto max-w-6xl px-4 py-12">
    <div class="mx-auto mb-8 max-w-2xl text-center lg:mx-0 lg:text-left">
      <h2 class="text-2xl font-bold tracking-tight">Two ways to clear the swamp</h2>
      <p class="mt-2 text-muted">
        Open the TUI when you want to look around. Reach for the CLI when you already know the target.
      </p>
    </div>
    <div class="grid gap-5 md:grid-cols-2">
      <ModeCard
        icon="tui"
        eyebrow="Donkey's guided tour"
        title="Guided TUI"
        description="Run either binary with no command to open the terminal UI. Browse, search, sort, inspect details, and use x/X for one PID or t/T for Linux/macOS tree cleanup."
        command="kickoutchi"
        href="/docs/tui"
        ctaLabel="Explore the TUI"
      />
      <ModeCard
        icon="cli"
        eyebrow="Dragon-speed route"
        title="Scriptable CLI"
        description="Print ports as a table or stable JSON, inspect process families, and choose process, tree, or Unix group scope with a fixed exit-code contract."
        command="kick list --json"
        href="/docs/cli"
        ctaLabel="Explore the CLI"
      />
    </div>
  </section>

  <!-- Features -->
  <section class="mx-auto max-w-6xl px-4 py-12">
    <div class="mx-auto mb-8 max-w-2xl text-center lg:mx-0 lg:text-left">
      <h2 class="text-2xl font-bold tracking-tight">A small tool that takes ports seriously</h2>
      <p class="mt-2 text-muted">Practical first, playful second. Everything here is real behaviour.</p>
    </div>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {FEATURES.map((feature) => <FeatureCard feature={feature} />)}
    </div>
  </section>

  <!-- Safety -->
  <section class="mx-auto max-w-6xl px-4 py-12">
    <div class="pocket-panel grid gap-8 p-6 text-center sm:p-10 lg:grid-cols-[0.9fr_1.1fr] lg:text-left">
      <div class="mx-auto max-w-xl lg:mx-0">
        <span class="inline-flex size-11 items-center justify-center rounded-xl bg-accent/10 text-accent">
          <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            <path d="M9 12l2 2 4-4"></path>
          </svg>
        </span>
        <h2 class="mt-4 text-2xl font-bold tracking-tight">Safe by default</h2>
        <p class="mt-3 text-muted">
          Terminating the wrong process is the scary part. Kickoutchi treats it that way: lots of
          guardrails, no silent surprises.
        </p>
        <ButtonLink href="/docs/safety" variant="secondary" size="sm" class="mt-5">
          How termination stays safe
        </ButtonLink>
      </div>
      <ul class="grid gap-3 self-center">
        {
          safety.map((item) => (
            <li class="flex gap-3 text-sm leading-relaxed">
              <svg class="mt-0.5 size-5 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 6 9 17l-5-5"></path>
              </svg>
              <span class="text-muted">{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Install preview + status -->
  <section class="mx-auto max-w-6xl px-4 py-12">
    <div class="pocket-panel p-6 sm:p-8">
      <div class="mx-auto max-w-5xl text-center">
        <h2 class="text-2xl font-bold tracking-tight">Install in one line</h2>
        <p class="mt-2 text-muted">Linux, macOS, and Windows get installers, archives, inspect, and explicit tree cleanup. Group scope stays Unix-only.</p>
        <div class="mt-5 text-left">
          <Terminal
            title="Linux & macOS"
            lines={[
              { kind: "command", text: "curl --proto '=https' --tlsv1.2 -LsSf \\" },
              { kind: "command", text: "  " + RELEASE_ASSETS.installerSh + " \\", prompt: " " },
              { kind: "command", text: "  | sh", prompt: " " },
            ]}
          />
        </div>
        <ButtonLink href="/install" class="mt-5">All install methods</ButtonLink>
      </div>

      <div class="mt-8 border-t border-border pt-6 text-center">
        <h3 class="text-xl font-bold tracking-tight">Platforms &amp; packages</h3>
        <p class="mt-2 text-sm text-muted">Honest status, kept compact.</p>
        <div class="mt-5 grid gap-3 md:grid-cols-3">
          {
            PLATFORM_SUPPORT.map((p) => (
              <div class="rounded-xl border border-border bg-surface-2/50 p-4 text-left">
                <p class="font-medium text-fg">{p.platform}</p>
                <p class="mt-2 text-xs leading-relaxed text-muted">{p.detail}</p>
              </div>
            ))
          }
        </div>
        <div class="mt-5 flex flex-wrap justify-center gap-x-4 gap-y-2 text-xs text-muted">
          <span class="inline-flex items-center gap-2">
            <StatusBadge status="available" />
            {availablePackages.map((pkg) => pkg.name).join(", ")}
          </span>
          {
            pendingPackages.map((pkg) => (
              <span class="inline-flex items-center gap-1.5 text-xs text-muted" title={pkg.detail}>
                <StatusBadge status={pkg.status} />
                {pkg.name}
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="mx-auto max-w-6xl px-4 py-12">
    <div class="pocket-panel flex flex-col items-center gap-5 p-10 text-center">
      <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">Ready to clear the swamp?</h2>
      <p class="max-w-xl text-muted">
        Install Kickoutchi, run it once with no arguments, and see the processes and process
        families using your local ports.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <ButtonLink href="/install">Install Kickoutchi</ButtonLink>
        <ButtonLink href={LINKS.github} variant="secondary" external>Star on GitHub</ButtonLink>
      </div>
    </div>
  </section>
</Layout>
