---
import Layout from "../layouts/Layout.astro";
import CopyButton from "../components/CopyButton.astro";
import KickDevice from "../components/KickDevice.astro";
import SwampHorizon from "../components/SwampHorizon.astro";
import { INSTALL_METHODS } from "../data/install-methods";
import { PLATFORM_SUPPORT } from "../data/package-status";
import { LINKS, SITE } from "../data/links";

/*
  Three type sizes only: text-sm (labels, commands), text-lg (reading),
  text-display (headlines and the pixel sign).
*/

const method = (id: string) => INSTALL_METHODS.find((m) => m.id === id)!;
const unix = method("installer-unix");
const windows = method("installer-windows");

/* Pixel stars for the night sky, placed once from a fixed pattern. */
const STARS = Array.from({ length: 34 }, (_, i) => ({
  x: (i * 37 + 11) % 100,
  y: (i * 53 + 7) % 92,
  big: i % 7 === 0,
}));

type Line = { kind: "cmd" | "out" | "dim" | "ok"; text: string };
const cmd = (text: string): Line => ({ kind: "cmd", text });
const out = (text: string): Line => ({ kind: "out", text });
const dim = (text: string): Line => ({ kind: "dim", text });
const ok = (text: string): Line => ({ kind: "ok", text });

const COMMANDS: { id: string; title: string; body: string; href: string; link: string; lines: Line[] }[] = [
  {
    id: "list",
    title: "Find the owner",
    body: "Port 3000 is busy. See the process behind it before you decide anything. Add --json for scripts.",
    href: "/docs/cli",
    link: "List and filter ports",
    lines: [
      cmd("kick list --port 3000"),
      out("PROTO  ADDRESS    PORT  PID    PROCESS  STATE"),
      out("TCP    127.0.0.1  3000  18422  node     LISTEN"),
    ],
  },
  {
    id: "inspect",
    title: "Read the family",
    body: "Dev servers leave workers behind. Inspect shows the tree, the group, and the exact command to clear it. Read-only.",
    href: "/docs/scoped-kills",
    link: "Inspect and scoped kills",
    lines: [
      cmd("kick inspect --port 3000"),
      out("Target: PID 18422 (node)"),
      out("  Command: node server.mjs"),
      out("  Ports: TCP 127.0.0.1:3000"),
      dim("  … ancestors and siblings"),
      out("Tree (3 processes):"),
      out("  PID 18422 (node) [TCP 127.0.0.1:3000]"),
      out("    PID 18431 (vite)"),
      out("    PID 18444 (esbuild)"),
      ok("To terminate this tree: kick kill --pid 18422 --tree"),
    ],
  },
  {
    id: "why",
    title: "Explain the conflict",
    body: "Got \"address already in use\"? Why probes the bind and returns the evidence, even when the owner is unclear.",
    href: "/docs/watch-and-why",
    link: "Understand bind failures",
    lines: [
      cmd("kick why 3000"),
      out("tcp://127.0.0.1:3000 verdict=owned certainty=proven"),
      out("  probe=address_in_use message=Address already in use (os error 98)"),
      out("  evidence code=visible_verified_owner source=linux_procfs"),
      out("    message=PID 18422 (node) owned the endpoint at snapshot capture"),
      ok("tcp://[::1]:3000 verdict=bindable_now certainty=proven"),
      dim("  … fields trimmed"),
    ],
  },
  {
    id: "watch",
    title: "Watch it change",
    body: "One line per change as servers bind, release, or get replaced. Pipe it anywhere.",
    href: "/docs/watch-and-why",
    link: "Watch ports live",
    lines: [
      cmd("kick watch --port 5173"),
      out("BIND TCP 127.0.0.1:5173 listen owners=21077 filter=matched certainty=proven"),
      out("RELEASE TCP 127.0.0.1:5173 listen owners=21077 filter=matched certainty=proven"),
      dim("  … observed timestamps trimmed"),
    ],
  },
  {
    id: "kill",
    title: "Kick it out",
    body: "One process by default, confirmed by you, checked again right before the signal.",
    href: "/docs/safety",
    link: "How confirmation works",
    lines: [
      cmd("kick kill --pid 18422"),
      out("Terminate PID 18422 (node)"),
      out("Scope: process"),
      out("Ports: TCP 127.0.0.1:3000"),
      out("Command: kill 18422"),
      out("Type y to confirm, or press Enter to cancel: y"),
      ok("sent SIGTERM to PID 18422 (node)"),
      ok("confirmed target ports are no longer visible"),
    ],
  },
];

const KEYS = [
  { key: "↵", label: "Details" },
  { key: "x", label: "Terminate" },
  { key: "X", label: "Force kill" },
  { key: "t", label: "Kill tree" },
  { key: "/", label: "Search" },
  { key: "m", label: "Full report" },
  { key: "?", label: "Help" },
  { key: "q", label: "Quit" },
];

const PIPELINE = [
  { title: "Find", body: "One snapshot ties every socket to its owner." },
  { title: "Inspect", body: "Read the tree and group. Nothing is stopped." },
  { title: "Confirm", body: "Type y, tree, force, or a protected PID." },
  { title: "Re-check", body: "Identity, ports, and protection are read again." },
  { title: "Signal", body: "SIGTERM by default. Any drift and it refuses." },
];

const CHANNELS = [
  { name: "Homebrew", where: "macOS, Linux", code: method("homebrew").commands[0].code },
  { name: "Scoop", where: "Windows", code: method("scoop").commands.map((c) => c.code).join("\n") },
  { name: "AUR", where: "Arch", code: method("aur-bin").commands[0].code },
  { name: "Nix", where: "Linux", code: method("nix").commands[0].code },
  { name: "Cargo", where: "Anywhere Rust runs", code: method("cargo").commands[0].code },
];
---

<Layout>
  <div class="landing">
    <!-- Hero: night sky, the pitch, and the device -->
    <section class="hero">
      <svg class="stars" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        {STARS.map((s) => <rect x={s.x} y={s.y} width={s.big ? 0.32 : 0.18} height={s.big ? 0.5 : 0.28} class={s.big ? "star-big" : "star"} />)}
      </svg>

      <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 pt-12 pb-6 sm:pt-16 lg:grid-cols-[1.2fr_1fr] lg:gap-16">
        <div class="min-w-0">
          <a href={`/changelog#v${SITE.version}`} class="release-chip text-sm">
            <span class="release-tag font-pixel">v{SITE.version}</span>
            <span>Batch kills with one summary, and exit checks that don't trust the port</span>
          </a>

          <h1 class="mt-7 text-display font-bold tracking-tight">
            Your ports have squatters.
            <span class="kick-line font-pixel">Kick them out.</span>
          </h1>

          <p class="mt-6 max-w-[34rem] text-lg text-muted">
            Kickoutchi is a TUI and CLI port janitor. See which process owns a local port, read its
            family, and clear the stale dev server without guessing.
          </p>

          <div id="quick-install" class="quick-install mt-8 scroll-mt-24">
            <fieldset>
              <legend class="sr-only">Install for your platform</legend>
              <div class="platforms">
                <input class="sr-only" type="radio" name="install-platform" id="install-unix" value="unix" checked />
                <label for="install-unix" class="text-sm">Linux &amp; macOS</label>
                <input class="sr-only" type="radio" name="install-platform" id="install-windows" value="windows" />
                <label for="install-windows" class="text-sm">Windows</label>
              </div>
            </fieldset>
            <div class="install-cmd unix-command">
              <pre class="font-mono text-sm"><code>{unix.commands[0].code}</code></pre>
              <CopyButton text={unix.commands[0].code} class="shrink-0" />
            </div>
            <div class="install-cmd windows-command">
              <pre class="font-mono text-sm"><code>{windows.commands[0].code}</code></pre>
              <CopyButton text={windows.commands[0].code} class="shrink-0" />
            </div>
            <p class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-muted">
              <span>Then run <code class="kbd-inline font-mono">kick</code> to open the TUI.</span>
              <a href="/install" class="ink-link">Homebrew, Scoop, AUR, Nix, Cargo →</a>
            </p>
          </div>
        </div>

        <div class="min-w-0">
          <KickDevice />
        </div>
      </div>

      <SwampHorizon />
    </section>

    <!-- The real TUI -->
    <section id="see-it" class="mx-auto max-w-6xl scroll-mt-20 px-4 pt-24 sm:pt-32">
      <div class="section-head">
        <div>
          <p class="eyebrow">The TUI</p>
          <h2 class="mt-4 text-display font-bold tracking-tight">Meet your port janitor.</h2>
        </div>
        <p class="text-lg text-muted">
          Run <code class="kbd-inline font-mono">kick</code> with no arguments. Every open port, its
          owner, and the details of whatever you select. Browsing never stops anything.
        </p>
      </div>

      <figure class="mt-12">
        <div class="screen-frame">
          <div class="screen-bar font-mono text-sm">
            <span><span class="text-term-accent">$</span> kick</span>
            <span class="text-faint">TUI · Linux</span>
          </div>
          <div class="overflow-x-auto" tabindex="0" role="region" aria-label="Kickoutchi TUI screenshot. Scroll horizontally to see the full terminal on smaller screens.">
            <img src="/previews/kickoutchi-tui.webp" alt="Kickoutchi showing a selected Node.js process on port 3000, its listening address, process details, and keyboard shortcuts for inspecting or terminating it." width="1320" height="624" class="block w-full min-w-[680px]" loading="lazy" />
          </div>
        </div>
        <figcaption class="mt-3 flex flex-wrap justify-between gap-2 text-sm text-faint">
          <span>Captured from a real session with a local demo server.</span>
          <a href="/previews/kickoutchi-tui.webp" target="_blank" rel="noopener noreferrer" class="ink-link">View full size ↗</a>
        </figcaption>
      </figure>

      <ul class="keys mt-12" aria-label="Main TUI keys">
        {KEYS.map((k) => (
          <li class="key-item">
            <kbd class="key font-mono text-lg">{k.key}</kbd>
            <span class="text-sm text-muted">{k.label}</span>
          </li>
        ))}
      </ul>

      <details class="confirm-peek mt-10">
        <summary class="text-sm">See the confirmation step</summary>
        <p class="mt-3 max-w-2xl text-sm text-muted">
          The prompt names the process and every affected port. Warnings wrap in full, and nothing
          stops until you confirm.
        </p>
        <div class="screen-frame mt-4 overflow-x-auto" tabindex="0" role="region" aria-label="Termination confirmation screenshot. Scroll horizontally on smaller screens.">
          <img src="/previews/kickoutchi-confirm.webp" alt="The confirmation dialog identifies the Node.js process, lists its ports 3000, 5173, and 8080, and offers y to confirm or Escape to cancel." width="1320" height="624" class="block w-full min-w-[680px]" loading="lazy" />
        </div>
      </details>
    </section>

    <!-- The CLI, as a command deck -->
    <section class="mx-auto max-w-6xl px-4 pt-24 sm:pt-32">
      <div class="section-head">
        <div>
          <p class="eyebrow">The CLI</p>
          <h2 class="mt-4 text-display font-bold tracking-tight">Get straight to it.</h2>
        </div>
        <p class="text-lg text-muted">
          Already know the port? Five verbs cover the job. Every transcript below uses the real
          output format.
        </p>
      </div>

      <div class="deck mt-12">
        <fieldset class="deck-tabs">
          <legend class="sr-only">Command</legend>
          {COMMANDS.map((c, i) => (
            <>
              <input class="sr-only" type="radio" name="deck" id={`deck-${c.id}`} checked={i === 0} />
              <label for={`deck-${c.id}`} class="deck-tab font-mono text-sm">{c.id}</label>
            </>
          ))}
        </fieldset>

        {COMMANDS.map((c) => (
          <div class="deck-panel" data-panel={c.id}>
            <div class="min-w-0">
              <h3 class="text-lg font-bold">{c.title}</h3>
              <p class="mt-2 text-lg text-muted">{c.body}</p>
              <div class="cli-cmd mt-5">
                <code class="font-mono text-sm">{c.lines[0].text}</code>
                <CopyButton text={c.lines[0].text} class="shrink-0" />
              </div>
              <a href={c.href} class="ink-link mt-4 inline-block text-sm">{c.link} →</a>
            </div>
            <pre class="transcript font-mono text-sm"><code>{c.lines.map((line) => (
              <span class:list={["line", `is-${line.kind}`]}>{line.kind === "cmd" && <span class="prompt">$ </span>}{line.text}</span>
            ))}</code></pre>
          </div>
        ))}
      </div>
    </section>

    <!-- Safety pipeline -->
    <section class="mx-auto max-w-6xl px-4 pt-24 sm:pt-32">
      <div class="section-head">
        <div>
          <p class="eyebrow">Safety</p>
          <h2 class="mt-4 text-display font-bold tracking-tight">Clear the right process.</h2>
        </div>
        <p class="text-lg text-muted">
          A PID can be reused and a port can change hands between two keystrokes. Every kick walks
          the same path, and it stops the moment the target is no longer the one you confirmed.
        </p>
      </div>

      <ol class="pipeline mt-14">
        {PIPELINE.map((step, i) => (
          <li class:list={["stop", i === PIPELINE.length - 1 && "stop-last"]}>
            <span class="stop-dot" aria-hidden="true"></span>
            <h3 class="font-pixel text-lg">{step.title}</h3>
            <p class="mt-1 text-sm text-muted">{step.body}</p>
          </li>
        ))}
      </ol>

      <div class="facts mt-12">
        <p class="fact text-lg"><span class="fact-mark" aria-hidden="true"></span><span>One process by default. Trees and groups only when you ask.</span></p>
        <p class="fact text-lg"><span class="fact-mark" aria-hidden="true"></span><span>Protected processes need the PID or name typed. <code class="kbd-inline font-mono">--yes</code> can't skip it.</span></p>
        <p class="fact text-lg"><span class="fact-mark" aria-hidden="true"></span><span>Changed or uncertain targets are refused, never guessed.</span></p>
      </div>
      <a href="/docs/safety" class="ink-link mt-8 inline-block text-sm">Read how the safety checks work →</a>
    </section>

    <!-- Platforms and channels -->
    <section class="mx-auto max-w-6xl px-4 pt-24 sm:pt-32">
      <div class="section-head">
        <div>
          <p class="eyebrow">Everywhere</p>
          <h2 class="mt-4 text-display font-bold tracking-tight">Runs in every swamp.</h2>
        </div>
        <p class="text-lg text-muted">
          Native collection on Linux, macOS, and Windows. No daemon to run. Two binaries ship
          together: <code class="kbd-inline font-mono">kickoutchi</code> and the short <code class="kbd-inline font-mono">kick</code>.
        </p>
      </div>

      <div class="mt-12 grid gap-4 md:grid-cols-3">
        {PLATFORM_SUPPORT.map((p) => (
          <div class="pocket-panel p-5">
            <p class="font-pixel text-lg">{p.platform}</p>
            <p class="mt-2 text-sm text-muted">{p.detail}</p>
          </div>
        ))}
      </div>

      <ul class="channels mt-10">
        {CHANNELS.map((c) => (
          <li class="channel">
            <div class="channel-head">
              <span class="font-bold">{c.name}</span>
              <span class="text-sm text-faint">{c.where}</span>
            </div>
            <div class="channel-cmd">
              <pre class="font-mono text-sm"><code>{c.code}</code></pre>
              <CopyButton text={c.code} class="shrink-0" />
            </div>
          </li>
        ))}
      </ul>
      <a href="/install" class="ink-link mt-6 inline-block text-sm">Every install method, with checksums and updates →</a>
    </section>

    <!-- Send-off -->
    <section class="mx-auto max-w-6xl px-4 pt-24 sm:pt-32">
      <div class="finale">
        <p class="finale-sign font-pixel text-display">Clear the swamp.</p>
        <div>
          <p class="text-lg">Your next dev server deserves a free port. Free and open source under MIT.</p>
          <div class="mt-7 flex flex-wrap items-center gap-4">
            <a href="/install" class="btn btn-kick text-lg">Install Kickoutchi</a>
            <a href="/docs" class="btn btn-ghost text-lg">Read the docs</a>
          </div>
          <a href={LINKS.github} target="_blank" rel="noopener noreferrer" class="ink-link mt-6 inline-block text-sm">View the source on GitHub ↗</a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .landing h1,
  .landing h2 {
    max-width: 14ch;
  }

  .ink-link {
    color: var(--accent);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .ink-link:hover {
    color: var(--fg);
  }
  .kbd-inline {
    padding: 0.05rem 0.35rem;
    border: 1px solid var(--border-strong);
    border-radius: 0.25rem;
    background: var(--surface-2);
    color: var(--fg);
    font-size: var(--text-sm);
  }

  /* ---- Hero ---- */
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--bg);
  }
  .stars {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: calc(100% - 200px);
    pointer-events: none;
  }
  .star {
    fill: #343d2c;
  }
  .star-big {
    fill: #56604a;
  }

  .release-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 100%;
    padding: 0.3rem 0.85rem 0.3rem 0.3rem;
    border: 2px solid var(--border-strong);
    border-radius: 0.4rem;
    background: var(--surface);
    color: var(--muted);
  }
  .release-chip:hover {
    border-color: var(--accent);
    color: var(--fg);
  }
  .release-tag {
    flex-shrink: 0;
    padding: 0.15rem 0.5rem;
    border-radius: 0.2rem;
    background: var(--lcd);
    color: var(--lcd-ink);
    letter-spacing: 0.04em;
  }

  .kick-line {
    display: block;
    margin-top: 0.4rem;
    color: var(--kick);
    font-weight: 600;
  }

  /* ---- Quick install ---- */
  .platforms {
    display: inline-flex;
    border: 2px solid var(--border-strong);
    border-bottom: 0;
    border-radius: 0.4rem 0.4rem 0 0;
    overflow: hidden;
  }
  .platforms label {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1rem;
    font-weight: 600;
    color: var(--muted);
    cursor: pointer;
  }
  .platforms label + input + label {
    border-left: 2px solid var(--border-strong);
  }
  .platforms input:checked + label {
    background: var(--term-accent);
    color: var(--term-accent-fg);
  }
  .platforms input:focus-visible + label {
    outline: 3px solid var(--kick);
    outline-offset: -3px;
  }
  .quick-install:has(#install-unix:checked) .windows-command,
  .quick-install:has(#install-windows:checked) .unix-command {
    display: none;
  }
  .install-cmd {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.9rem 0.9rem 0.9rem 1rem;
    border: 2px solid var(--border-strong);
    border-radius: 0 0.4rem 0.4rem 0.4rem;
    background: var(--term-bg);
    color: var(--term-fg);
    box-shadow: 4px 4px 0 0 var(--drop);
  }
  .install-cmd pre {
    flex: 1;
    min-width: 0;
    margin: 0;
    line-height: 1.6;
    white-space: pre-wrap;
    /* break-all, not overflow-wrap: the indented URL line would otherwise
       leave its two leading spaces stranded on a blank line. */
    word-break: break-all;
  }

  /* ---- Section heads ---- */
  .section-head {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 1024px) {
    .section-head {
      grid-template-columns: 1.2fr 1fr;
      align-items: end;
      gap: 4rem;
    }
  }

  /* ---- Screens ---- */
  .screen-frame {
    overflow: hidden;
    border: 2px solid var(--border-strong);
    border-radius: 0.5rem;
    background: var(--term-bg);
    box-shadow: 6px 6px 0 0 var(--drop);
  }
  .screen-bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 1rem;
    border-bottom: 2px solid var(--border-strong);
    background: var(--surface);
    color: var(--fg);
  }

  .keys {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 1rem;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 640px) {
    .keys {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .keys {
      grid-template-columns: repeat(8, minmax(0, 1fr));
    }
  }
  .key-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .key {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 2px solid #11140d;
    border-radius: 0.4rem;
    background: var(--shell);
    color: var(--lcd-ink);
    font-weight: 700;
    box-shadow:
      inset -2px -3px 0 0 var(--shell-shade),
      0 3px 0 0 #000;
  }

  .confirm-peek summary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    cursor: pointer;
    color: var(--accent);
    font-weight: 600;
  }
  .confirm-peek summary::marker {
    color: var(--kick);
  }

  /* ---- Command deck ---- */
  .deck {
    border: 2px solid var(--border-strong);
    border-radius: 0.5rem;
    background: var(--surface);
    box-shadow: 6px 6px 0 0 var(--drop);
    overflow: hidden;
  }
  .deck-tabs {
    display: flex;
    overflow-x: auto;
    margin: 0;
    padding: 0;
    border: 0;
    border-bottom: 2px solid var(--border-strong);
    background: var(--surface-2);
  }
  .deck-tab {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0 1.25rem;
    border-right: 2px solid var(--border-strong);
    color: var(--muted);
    cursor: pointer;
    white-space: nowrap;
  }
  .deck-tab::before {
    content: "kick\00a0";
    color: var(--faint);
  }
  .deck-tab:hover {
    color: var(--fg);
  }
  .deck-tabs input:checked + .deck-tab {
    background: var(--term-accent);
    color: var(--term-accent-fg);
    font-weight: 700;
  }
  .deck-tabs input:checked + .deck-tab::before {
    color: rgb(0 0 0 / 0.55);
  }
  .deck-tabs input:focus-visible + .deck-tab {
    outline: 3px solid var(--kick);
    outline-offset: -3px;
  }
  .deck-panel {
    display: none;
    gap: 2rem;
    padding: 1.5rem;
  }
  @media (min-width: 900px) {
    .deck-panel {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.45fr);
      padding: 2rem;
      gap: 2.5rem;
    }
  }
